---
import { Image } from 'astro:assets';
import { ArrowRight, BatteryLow, HeartPulse, PersonStanding } from '@lucide/astro';
import { PILLARS, type PillarKey } from '../data/pillars';
import apaGuideImage from '../assets/guide-apa-photo.jpg';
import chronicGuideImage from '../assets/guide-maladie-chronique-photo.jpg';
import fatigueGuideImage from '../assets/guide-fatigue-photo.jpg';

interface Props {
	exclude?: PillarKey;
	title?: string;
	intro?: string;
	compact?: boolean;
}

const {
	exclude,
	title = 'Comprendre, à ton rythme',
	intro = "Trois guides pédagogiques pour poser les bons repères avant ou pendant l'accompagnement.",
	compact = false,
} = Astro.props;

const pillars = PILLARS.filter((p) => p.key !== exclude);

const iconByKey = {
	apa: HeartPulse,
	'maladie-chronique': PersonStanding,
	fatigue: BatteryLow,
} as const;

const imageByKey = {
	apa: {
		src: apaGuideImage,
		alt: "Séance d'Activité Physique Adaptée suivie en ligne depuis chez soi",
	},
	'maladie-chronique': {
		src: chronicGuideImage,
		alt: 'Progression douce et mouvement adapté avec une maladie chronique',
	},
	fatigue: {
		src: fatigueGuideImage,
		alt: 'Alternance entre repos et mouvement en cas de fatigue chronique',
	},
} as const;

const reveal = compact
	? ''
	: 'opacity-0 translate-y-4 transition duration-700 ease-out will-change-transform will-change-opacity motion-reduce:transition-none data-[revealed=true]:opacity-100 data-[revealed=true]:translate-y-0';
---

<section
	class:list={[compact ? 'py-8' : 'bg-(--surface-container-low) py-20 sm:px-10', reveal]}
	{...(compact ? {} : { 'data-reveal': true, 'data-revealed': 'false' })}
	aria-labelledby="pillars-hub-title"
>
	<div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
		{
			!compact && (
				<div class="mx-auto max-w-3xl text-center">
					<p class="text-sm font-semibold tracking-[0.22em] text-(--primary-container)">COMPRENDRE</p>
					<h2 id="pillars-hub-title" class="mt-2 text-3xl text-(--primary) sm:text-4xl">
						{title}
					</h2>
					<p class="mt-4 text-base leading-relaxed text-(--secondary)">{intro}</p>
				</div>
			)
		}
		{
			compact && (
				<h2 id="pillars-hub-title" class="text-xl text-(--primary)">
					{title}
				</h2>
			)
		}

		<div
			class:list={[
				compact ? 'mt-5 grid gap-3 sm:grid-cols-3' : 'mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3',
			]}
		>
			{
				pillars.map((p) => {
					const Icon = iconByKey[p.key];
					const image = imageByKey[p.key];
					return (
						<a
							href={p.slug}
							class="group flex h-full flex-col overflow-hidden rounded-2xl bg-(--surface-container-lowest) soft-glow transition hover:-translate-y-0.5 motion-reduce:hover:translate-y-0"
						>
							{!compact && (
								<div class="relative aspect-[4/3] overflow-hidden bg-(--sage)/20">
									<Image
										src={image.src}
										alt={image.alt}
										class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
										width={640}
										height={480}
									/>
								</div>
							)}
							<div class="flex flex-1 flex-col p-6">
								<div class="mb-3 flex items-center gap-3">
									<span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-(--primary-fixed)">
										<Icon class="size-5 text-(--primary)" aria-hidden="true" stroke-width={1.7} />
									</span>
									<p class="font-semibold text-(--primary)">{p.label}</p>
								</div>
								<p class="text-sm leading-relaxed text-(--secondary)">{p.tagline}</p>
								<span class="mt-auto inline-flex items-center gap-1.5 pt-4 text-sm font-semibold text-(--primary) transition group-hover:gap-2">
									Lire le guide
									<ArrowRight class="size-4" aria-hidden="true" stroke-width={2} />
								</span>
							</div>
						</a>
					);
				})
			}
		</div>
	</div>
</section>
