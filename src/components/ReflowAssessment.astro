---
/**
 * Auto-évaluation Re-flow — questionnaire interactif.
 *
 * Rendu serveur : les 10 questions sont dans le HTML (SEO + fonctionne sans JS).
 * Le script transforme ensuite le formulaire en parcours « une question à la fois ».
 */
import { Battery, CircleCheck, Compass, Frown, Heart, Lock, Meh, Move, RotateCcw, Smile } from '@lucide/astro';
import { COACH_FIRST_NAME, SITE_BRAND } from '../consts';
import {
	MAX_SCORE,
	MIN_SCORE,
	PERCENT_MAX,
	PROFILES,
	QUESTIONS,
	SECTIONS,
	SECTIONS_BY_KEY,
	SKIPPED_QUESTION_IDS,
	SKIP_TRIGGER_POINTS,
	SKIP_TRIGGER_QUESTION_ID,
	TOTAL_QUESTIONS,
} from '../data/reflow';

const sectionIcons = {
	endurance: Battery,
	capacites: Move,
	quotidien: Heart,
	reprise: Compass,
} as const;

const scoreSpan = PERCENT_MAX - MIN_SCORE + 1;
const bands = PROFILES.map((p) => ({
	key: p.key,
	label: p.label,
	tone: p.tone,
	width: ((p.max - p.min + 1) / scoreSpan) * 100,
}));
---

<div
	class="scroll-mt-28 rounded-3xl bg-(--surface-container-low) p-4 ring-1 ring-(--outline-variant)/60 sm:p-8"
	data-rg-root
	data-skip-trigger={SKIP_TRIGGER_QUESTION_ID}
	data-skip-ids={SKIPPED_QUESTION_IDS.join(',')}
	data-skip-points={String(SKIP_TRIGGER_POINTS)}
	data-total={String(TOTAL_QUESTIONS)}
	data-min={String(MIN_SCORE)}
	data-max={String(MAX_SCORE)}
>
	{/* ---------- Progression (activée par le script) ---------- */}
	<div class="mb-6" data-rg-progress hidden>
		<div class="flex items-baseline justify-between gap-4">
			<p class="text-sm font-semibold tracking-[0.18em] text-(--primary-container)" data-rg-progress-label>
				QUESTION 1 SUR {TOTAL_QUESTIONS}
			</p>
			<p class="text-sm text-(--secondary)" data-rg-progress-section>{SECTIONS[0].label}</p>
		</div>
		<div
			class="mt-3 h-2 overflow-hidden rounded-full bg-(--surface-container-high)"
			role="progressbar"
			aria-valuemin="1"
			aria-valuemax={TOTAL_QUESTIONS}
			aria-valuenow="1"
			aria-label="Progression dans le questionnaire"
			data-rg-progressbar
		>
			<div
				class="h-full rounded-full bg-(--primary) transition-[width] duration-500 ease-out motion-reduce:transition-none"
				style="width: 10%"
				data-rg-progress-fill
			>
			</div>
		</div>
		<p class="sr-only" aria-live="polite" data-rg-live></p>
	</div>

	{/* ---------- Questionnaire ---------- */}
	<form data-rg-form novalidate>
		{
			QUESTIONS.map((q) => (
				<fieldset
					class="rg-step border-0 p-0"
					data-rg-step
					data-qid={q.id}
					data-number={String(q.number)}
					data-section={q.section}
					data-section-label={SECTIONS_BY_KEY[q.section].label}
				>
					<legend
						class="mb-1 w-full rounded-lg text-xl leading-snug font-semibold text-(--on-surface) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--primary) sm:text-2xl"
						tabindex="-1"
					>
						<span class="mr-2 text-(--primary-container)">{q.number}.</span>
						{q.label}
					</legend>

					{q.hint && <p class="mb-1 text-sm leading-relaxed text-(--secondary)">{q.hint}</p>}

					<div class="mt-5 grid gap-2.5">
						{q.options.map((o) => (
							<label class="group relative flex cursor-pointer items-center gap-3 rounded-2xl bg-(--surface-container-lowest) px-4 py-3.5 ring-1 ring-(--outline-variant) transition hover:ring-(--primary)/40 has-[:checked]:bg-(--primary-fixed)/35 has-[:checked]:ring-2 has-[:checked]:ring-(--primary) has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-(--primary) motion-reduce:transition-none">
								<input
									type="radio"
									class="sr-only"
									name={q.id}
									value={String(o.points)}
									data-section={q.section}
									data-skip={
										q.id === SKIP_TRIGGER_QUESTION_ID && o.points === SKIP_TRIGGER_POINTS
											? 'true'
											: undefined
									}
								/>
								<span
									class="grid size-5 shrink-0 place-items-center rounded-full ring-1 ring-(--outline)/40 transition group-has-[:checked]:ring-2 group-has-[:checked]:ring-(--primary) motion-reduce:transition-none"
									aria-hidden="true"
								>
									<span class="size-2.5 rounded-full bg-(--primary) opacity-0 transition group-has-[:checked]:opacity-100 motion-reduce:transition-none" />
								</span>
								<span class="text-base leading-snug text-(--on-surface) group-has-[:checked]:font-semibold">
									{o.label}
								</span>
							</label>
						))}
					</div>
				</fieldset>
			))
		}

		{/* ---------- Navigation (activée par le script) ---------- */}
		<div class="mt-7 flex items-center justify-between gap-3" data-rg-nav hidden>
			<button
				type="button"
				class="inline-flex items-center justify-center rounded-full border border-(--outline-variant) bg-(--surface-container-lowest) px-5 py-2.5 text-base font-medium text-(--secondary) transition hover:text-(--primary) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--primary) disabled:pointer-events-none disabled:opacity-40 motion-reduce:transition-none"
				data-rg-prev
			>
				Précédent
			</button>
			<button
				type="button"
				class="inline-flex items-center justify-center rounded-full bg-(--primary) px-7 py-3 text-base font-medium text-(--on-primary) transition hover:bg-(--primary-container) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--primary) disabled:pointer-events-none disabled:opacity-40 motion-reduce:transition-none"
				data-rg-next
				disabled
			>
				Suivant
			</button>
		</div>

		{/* ---------- Repli sans JavaScript ---------- */}
		<div
			class="mt-7 rounded-2xl bg-(--surface-container-lowest) px-5 py-4 text-sm leading-relaxed text-(--secondary) ring-1 ring-(--outline-variant)"
			data-rg-nojs
		>
			<p class="font-semibold text-(--on-surface)">Calculer ton résultat à la main</p>
			<p class="mt-2">
				JavaScript est désactivé : le calcul automatique n’est pas disponible. Dans chaque question, les
				réponses vont de 0 (Pas du tout) à 4 (Énormément). Additionnez les points de tes {
					TOTAL_QUESTIONS
				} réponses, puis calculez (total / {MAX_SCORE}) × 100 pour obtenir un pourcentage de
				déconditionnement.
			</p>
			<ul class="mt-2 ml-5 list-disc">
				{
					PROFILES.map((p) => (
						<li>
							{p.range} : <strong class="text-(--on-surface)">{p.label}</strong>
						</li>
					))
				}
			</ul>
		</div>
	</form>

	{/* ---------- Résultat ---------- */}
	<section data-rg-result hidden aria-labelledby="rg-result-title">
		<div class="text-center" data-rg-result-summary>
			<p class="text-sm font-semibold tracking-[0.18em] text-(--primary-container)">TON RÉSULTAT</p>
			<h2
				id="rg-result-title"
				class="mt-3 rounded-lg text-4xl font-semibold text-(--primary) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--primary) sm:text-5xl"
				tabindex="-1"
				data-rg-total
			>
				<span data-rg-score>—</span><span class="text-(--secondary)">&nbsp;%</span>
			</h2>
			<p class="mt-4">
				<span
					class="inline-flex items-center rounded-full bg-(--primary) px-5 py-2 text-base font-semibold text-(--on-primary)"
					data-rg-badge>—</span
				>
			</p>
		</div>

		{/* Jauge */}
		<div class="mt-8">
			<div class="relative">
				<div class="flex h-3 overflow-hidden rounded-full" aria-hidden="true">
					{
						bands.map((b) => (
							<div
								class:list={[
									'h-full',
									b.tone === 'low' ? 'rg-band-low' : b.tone === 'mid' ? 'rg-band-mid' : 'rg-band-high',
								]}
								style={`width: ${b.width}%`}
							/>
						))
					}
				</div>
				<span
					class="absolute top-1/2 size-5 -translate-x-1/2 -translate-y-1/2 rounded-full border-4 border-(--surface-container-low) bg-(--primary) shadow transition-[left] duration-700 ease-out motion-reduce:transition-none"
					style="left: 0%"
					data-rg-marker
					aria-hidden="true"></span>
			</div>
			<div class="mt-2 flex text-xs text-(--secondary)" aria-hidden="true">
				{
					bands.map((b, i) => (
						<span
							class:list={[i === 0 ? 'text-left' : i === bands.length - 1 ? 'text-right' : 'text-center']}
							style={`width: ${b.width}%`}
						>
							{b.label}
						</span>
					))
				}
			</div>
		</div>

		{/* Interprétation */}
		<div class="mt-8">
			<h3 class="text-lg font-semibold text-(--on-surface)">L’interprétation de ton résultat</h3>
			{
				PROFILES.map((p) => (
					<div
						class="mt-4"
						data-rg-profile={p.key}
						data-label={p.label}
						data-min={String(p.min)}
						data-max={String(p.max)}
						data-tone={p.tone}
						hidden
					>
						<p class="text-lg leading-relaxed font-semibold text-(--on-surface)">{p.summary}</p>
						{
							SECTIONS.map((s) => (
								<p class="mt-3 text-base leading-relaxed text-(--on-surface)" data-rg-dimension={s.key} hidden>
									{s.resultCopy}
								</p>
							))
						}
						<div class="relative mt-4 max-h-80 overflow-hidden rounded-2xl">
							<div
								class="pointer-events-none select-none blur-[6px]"
								aria-hidden="true"
							>
								{p.advice.map((a) => (
									<p class="mt-4 text-base leading-relaxed text-(--on-surface) first:mt-0">{a}</p>
								))}
								{SECTIONS.map((s) => (
									<p
										class="mt-4 text-base leading-relaxed text-(--on-surface)"
										data-rg-blur-dimension={s.key}
										hidden
									>
										{s.advice}
									</p>
								))}
							</div>
							<div
								class="pointer-events-none absolute inset-0 bg-linear-to-b from-transparent via-(--surface-container-low)/25 to-(--surface-container-low)/70"
								aria-hidden="true"
							>
							</div>
							<div class="absolute inset-0 flex flex-col items-center justify-center px-5 text-center">
								<button
									type="button"
									class="flex cursor-pointer flex-col items-center rounded-2xl bg-white/80 px-5 py-5 shadow-lg ring-1 ring-black/8 backdrop-blur-md transition hover:bg-white hover:ring-(--primary)/30 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--primary) motion-reduce:transition-none"
									data-rg-scroll-booking
								>
									<span
										class="mx-auto grid size-12 place-items-center rounded-full bg-(--primary)/10 text-(--primary)"
									>
										<Lock class="size-5" aria-hidden="true" stroke-width={1.8} />
									</span>
									<span class="mt-3 block text-base font-semibold text-(--on-surface)">
										Tes points d’amélioration sont identifiés
									</span>
									<span class="mt-1 block text-sm leading-relaxed text-(--secondary)">
										Réserve ton bilan pour les découvrir{' '}
										<span aria-hidden="true">👇</span>
									</span>
								</button>
							</div>
						</div>
					</div>
				))
			}

			<div
				class="mt-6 scroll-mt-28 rounded-2xl border-2 border-(--error) bg-(--surface-container-lowest) px-5 py-6 sm:px-8 sm:py-8"
				data-rg-booking
			>
				<div class="text-center">
					<p class="text-xs font-semibold tracking-[0.18em] text-(--error) uppercase">
						Bilan offert — {SITE_BRAND}
					</p>
					<h4 class="mt-2 text-xl leading-snug font-semibold text-(--on-surface) sm:text-2xl">
						Réserve ton bilan et découvre tes points d’amélioration
					</h4>
					{
						SECTIONS.map((s) => (
							<p
								class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-(--secondary)"
								data-rg-transition={s.key}
								hidden
							>
								{s.transitionCopy}
							</p>
						))
					}
					<ul class="mx-auto mt-5 max-w-lg space-y-3 text-left text-sm leading-relaxed text-(--secondary)">
						<li class="flex gap-3">
							<CircleCheck
								class="mt-0.5 size-5 shrink-0 text-(--error)"
								aria-hidden="true"
								stroke-width={1.8}
							/>
							<span>
								<strong class="font-semibold text-(--on-surface)"
									>Un bilan offert avec {COACH_FIRST_NAME}</strong
								>{' '}
								pour lire tes résultats et voir comment reconstruire progressivement ta condition physique
							</span>
						</li>
						<li class="flex gap-3">
							<CircleCheck
								class="mt-0.5 size-5 shrink-0 text-(--error)"
								aria-hidden="true"
								stroke-width={1.8}
							/>
							<span>
								<strong class="font-semibold text-(--on-surface)">Un plan d’action clair</strong>{' '}
								pour avancer à partir de ce que ton corps peut faire aujourd’hui
							</span>
						</li>
						<li class="flex gap-3">
							<CircleCheck
								class="mt-0.5 size-5 shrink-0 text-(--error)"
								aria-hidden="true"
								stroke-width={1.8}
							/>
							<span>
								<strong class="font-semibold text-(--on-surface)">On regarde ensemble</strong> si
								l’accompagnement {SITE_BRAND} est fait pour toi
							</span>
						</li>
					</ul>
				</div>
				<div class="mt-6 min-h-150" data-rg-booking-mount></div>
			</div>
		</div>

		{/* Sous-scores */}
		<div class="mt-10">
			<h3 class="text-lg font-semibold text-(--on-surface)">Le détail, dimension par dimension</h3>
			<p class="mt-1 text-sm leading-relaxed text-(--secondary)">
				Le pourcentage représente le{' '}
				<strong class="font-semibold text-(--on-surface)">niveau de déconditionnement actuel</strong>
				. 0&nbsp;% : plutôt limité. 100&nbsp;% : très important.
			</p>

			<div class="mt-5 grid gap-3 sm:grid-cols-2">
				{
					SECTIONS.map((s) => {
						const Icon = sectionIcons[s.key];
						return (
							<div
								class="rg-section rounded-2xl bg-(--surface-container-lowest) p-5 soft-glow"
								data-rg-section={s.key}
								data-max={String(s.maxScore)}
							>
								<div class="flex items-center gap-2.5">
									<span class="rg-chip flex size-9 shrink-0 items-center justify-center rounded-xl">
										<Icon class="size-4.5" aria-hidden="true" stroke-width={1.7} />
									</span>
									<p class="text-sm leading-snug font-medium text-(--on-surface)">{s.shortLabel}</p>
									<span
										class="rg-sentiment ml-auto grid size-9 shrink-0 place-items-center rounded-full"
										aria-hidden="true"
									>
										<span data-rg-sentiment data-tone="low" hidden>
											<Frown class="size-5" stroke-width={1.8} />
										</span>
										<span data-rg-sentiment data-tone="mid" hidden>
											<Meh class="size-5" stroke-width={1.8} />
										</span>
										<span data-rg-sentiment data-tone="high" hidden>
											<Smile class="size-5" stroke-width={1.8} />
										</span>
									</span>
								</div>

								<p class="mt-3 text-2xl font-semibold text-(--primary)">
									<span data-rg-section-score={s.key}>—</span>
									<span class="text-base font-normal text-(--secondary)">&nbsp;%</span>
								</p>

								<div
									class="mt-2 h-1.5 overflow-hidden rounded-full bg-(--outline)/12"
									aria-hidden="true"
								>
									<div
										class="rg-bar h-full rounded-full transition-[width] duration-700 ease-out motion-reduce:transition-none"
										style="width: 0%"
									/>
								</div>

								<p class="mt-2.5 text-sm leading-snug font-medium text-(--on-surface)" data-rg-section-level>
									{s.levels.map((l) => (
										<span data-rg-level data-up-to={String(l.upTo)} data-tone={l.tone} hidden>
											{l.label}
										</span>
									))}
								</p>

								<p class="mt-2 text-xs leading-relaxed text-(--outline)">{s.caption}</p>
								<p
									class="mt-2 text-xs font-semibold text-(--primary)"
									data-rg-dominant-label
									hidden
								>
									Déconditionnement le plus marqué
								</p>
							</div>
						);
					})
				}
			</div>
		</div>

		{/* Rappel non médical */}
		<p
			class="mt-8 rounded-2xl bg-(--secondary-container)/40 px-5 py-4 text-sm leading-relaxed text-(--on-secondary-container)"
		>
			<strong>Cette auto-évaluation est un outil de réflexion et ne constitue pas un diagnostic médical.</strong>{' '}
			Elle évalue le déconditionnement physique, pas la maladie. Elle ne
			remplace ni un avis médical, ni un bilan, ni un suivi de santé. Les seuils utilisés ici sont
			propres à l’expérience Re-flow.
		</p>

		<div class="mt-8 text-center">
			<button
				type="button"
				class="inline-flex items-center justify-center gap-2 rounded-full border border-(--outline-variant) bg-(--surface-container-lowest) px-6 py-3 text-base font-medium text-(--primary) transition hover:bg-(--surface-container) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--primary) motion-reduce:transition-none"
				data-rg-restart
			>
				<RotateCcw class="size-4" aria-hidden="true" stroke-width={2} />
				Refaire le test
			</button>
		</div>
	</section>

	<p class="mt-6 text-center text-xs leading-relaxed text-(--secondary)">
		Cette auto-évaluation est un outil de réflexion et ne constitue pas un diagnostic médical. Aucune
		réponse n’est enregistrée ni transmise : tout le calcul se fait dans ton navigateur.
	</p>
</div>

<style>
	/* Mode « une question à la fois » : activé uniquement quand le script a démarré. */
	[data-rg-root][data-js='on'] .rg-step:not([data-current]) {
		display: none;
	}

	/* Teintes des sous-scores : mêmes trois tons que la jauge principale,
	   pour qu'on n'ait qu'une seule échelle à apprendre. */
	.rg-band-low {
		background: #e9b8b0;
	}
	.rg-band-mid {
		background: #f4d49a;
	}
	.rg-band-high {
		background: #a8d7be;
	}
	[data-rg-total][data-tone='low'] {
		color: #b9473b;
	}
	[data-rg-total][data-tone='mid'] {
		color: #a56508;
	}
	[data-rg-total][data-tone='high'] {
		color: #2f805e;
	}
	[data-rg-badge][data-tone='low'],
	[data-rg-marker][data-tone='low'] {
		background: #b9473b;
		color: white;
	}
	[data-rg-badge][data-tone='mid'],
	[data-rg-marker][data-tone='mid'] {
		background: #a56508;
		color: white;
	}
	[data-rg-badge][data-tone='high'],
	[data-rg-marker][data-tone='high'] {
		background: #2f805e;
		color: white;
	}
	.rg-section .rg-chip {
		background: #f8e1dd;
		color: #9b342c;
	}
	.rg-section .rg-bar {
		background: #c35649;
	}
	.rg-section .rg-sentiment {
		background: #f8e1dd;
		color: #9b342c;
	}
	.rg-section[data-tone='mid'] .rg-chip {
		background: #f8ecd2;
		color: #8d5a0a;
	}
	.rg-section[data-tone='mid'] .rg-bar {
		background: #c78113;
	}
	.rg-section[data-tone='mid'] .rg-sentiment {
		background: #f8ecd2;
		color: #8d5a0a;
	}
	.rg-section[data-tone='high'] .rg-chip {
		background: #dcefe4;
		color: #2e7959;
	}
	.rg-section[data-tone='high'] .rg-bar {
		background: #45956d;
	}
	.rg-section[data-tone='high'] .rg-sentiment {
		background: #dcefe4;
		color: #2e7959;
	}

	[data-rg-result][data-revealed='true'] [data-rg-result-summary] {
		animation: rg-result-rise 560ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}
	[data-rg-result][data-revealed='false'] [data-rg-result-summary],
	[data-rg-result][data-revealed='false'] [data-rg-badge] {
		opacity: 0;
	}
	[data-rg-result][data-revealed='true'] [data-rg-badge] {
		animation: rg-result-badge 480ms 180ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
	}

	@keyframes rg-result-rise {
		from {
			opacity: 0;
			transform: translateY(18px) scale(0.97);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	@keyframes rg-result-badge {
		from {
			opacity: 0;
			transform: translateY(8px) scale(0.78);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		[data-rg-result][data-revealed='true'] [data-rg-result-summary],
		[data-rg-result][data-revealed='true'] [data-rg-badge] {
			animation: none;
		}
	}
</style>

<script>
	const trackUmami = (name: string) => {
		const umami = (window as unknown as { umami?: { track?: (n: string) => void } }).umami;
		umami?.track?.(name);
	};

	document.querySelectorAll<HTMLElement>('[data-rg-root]').forEach((root) => {
		const form = root.querySelector<HTMLFormElement>('[data-rg-form]');
		const result = root.querySelector<HTMLElement>('[data-rg-result]');
		const nav = root.querySelector<HTMLElement>('[data-rg-nav]');
		const progress = root.querySelector<HTMLElement>('[data-rg-progress]');
		const nojs = root.querySelector<HTMLElement>('[data-rg-nojs]');
		if (!form || !result || !nav || !progress || !nojs) return;

		const steps = Array.from(root.querySelectorAll<HTMLFieldSetElement>('[data-rg-step]'));
		if (steps.length === 0) return;

		const prevBtn = nav.querySelector<HTMLButtonElement>('[data-rg-prev]')!;
		const nextBtn = nav.querySelector<HTMLButtonElement>('[data-rg-next]')!;
		const progressLabel = progress.querySelector<HTMLElement>('[data-rg-progress-label]')!;
		const progressSection = progress.querySelector<HTMLElement>('[data-rg-progress-section]')!;
		const progressBar = progress.querySelector<HTMLElement>('[data-rg-progressbar]')!;
		const progressFill = progress.querySelector<HTMLElement>('[data-rg-progress-fill]')!;
		const live = progress.querySelector<HTMLElement>('[data-rg-live]')!;
		const skipNote = root.querySelector<HTMLElement>('[data-rg-skip-note]');

		const total = Number(root.dataset.total) || steps.length;
		const minScore = root.dataset.min === undefined ? 0 : Number(root.dataset.min);
		const maxScore = Number(root.dataset.max) || steps.length * 4;
		const skipPoints = Number(root.dataset.skipPoints) || 0;
		const skipIds = (root.dataset.skipIds ?? '').split(',').filter(Boolean);

		let current = 0;
		const autoAdvanced = new Set<number>();
		let lastPointerAt = 0;
		let startedTracked = false;
		let resultShown = false;

		const radiosOf = (step: HTMLFieldSetElement) =>
			Array.from(step.querySelectorAll<HTMLInputElement>('input[type="radio"]'));

		const isSkipping = () => {
			const trigger = form.querySelector<HTMLInputElement>('input[data-skip="true"]');
			return Boolean(trigger?.checked);
		};

		const isSkipped = (step: HTMLFieldSetElement) =>
			isSkipping() && skipIds.includes(step.dataset.qid ?? '');

		const isActive = (i: number) => !isSkipped(steps[i]);

		const isAnswered = (step: HTMLFieldSetElement) => radiosOf(step).some((r) => r.checked);

		let wasSkipping = false;

		/**
		 * Coche (ou décoche) automatiquement les questions sautées.
		 * Conservé comme no-op : cette auto-évaluation n'a plus de questions sautées.
		 */
		const syncSkipped = () => {
			const skipping = isSkipping();
			if (skipping !== wasSkipping) {
				wasSkipping = skipping;
				steps.forEach((step) => {
					if (!skipIds.includes(step.dataset.qid ?? '')) return;
					const radios = radiosOf(step);
					if (skipping) {
						const fallback = radios.find((r) => Number(r.value) === skipPoints);
						if (fallback) fallback.checked = true;
					} else {
						radios.forEach((r) => {
							r.checked = false;
						});
					}
				});
			}
			if (skipNote) skipNote.hidden = !skipping;
		};

		/**
		 * Ne défile que si la question est masquée par le header collant ou sortie
		 * de l'écran : sinon on laisse la page où l'utilisatrice l'a mise.
		 */
		const ensureVisible = (step: HTMLFieldSetElement) => {
			const headerHeight = document.querySelector('header')?.getBoundingClientRect().height ?? 0;
			const stepTop = step.getBoundingClientRect().top;
			const rootTop = root.getBoundingClientRect().top;
			// scroll-mt-28 (112px) repose le haut du widget sous le header : la
			// condition reste vraie après le défilement, donc pas d'oscillation.
			if (stepTop > headerHeight + 8 && rootTop >= headerHeight + 8) return;
			root.scrollIntoView({ block: 'start', behavior: 'smooth' });
		};

		const findNext = (from: number, dir: 1 | -1) => {
			let i = from + dir;
			while (i >= 0 && i < steps.length && !isActive(i)) i += dir;
			return i;
		};

		const render = (focus: boolean) => {
			steps.forEach((step, i) => {
				if (i === current) step.setAttribute('data-current', '');
				else step.removeAttribute('data-current');
			});

			const step = steps[current];
			const number = Number(step.dataset.number) || current + 1;
			progressLabel.textContent = `QUESTION ${number} SUR ${total}`;
			progressSection.textContent = step.dataset.sectionLabel ?? '';
			progressBar.setAttribute('aria-valuenow', String(number));
			progressFill.style.width = `${(number / total) * 100}%`;
			live.textContent = `Question ${number} sur ${total}.`;

			prevBtn.disabled = findNext(current, -1) < 0;
			nextBtn.disabled = !isAnswered(step);
			nextBtn.textContent =
				findNext(current, 1) >= steps.length ? 'Voir mon résultat' : 'Suivant';

			if (!focus) return;
			// On garde la main sur le défilement : le focus ne doit pas faire glisser
			// la question sous le header collant.
			step.querySelector<HTMLElement>('legend')?.focus({ preventScroll: true });
			ensureVisible(step);
		};

		const goTo = (i: number, focus = true) => {
			if (i < 0 || i >= steps.length) return;
			current = i;
			render(focus);
		};

		const showDimension = (attr: string, key: string) => {
			result.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((el) => {
				el.hidden = el.getAttribute(attr) !== key;
			});
		};

		const showResult = () => {
			if (resultShown) return;
			resultShown = true;
			let totalScore = 0;
			const bySection = new Map<string, number>();

			steps.forEach((step) => {
				const checked = radiosOf(step).find((r) => r.checked);
				if (!checked) return;
				const points = Number(checked.value);
				const value = Number.isFinite(points) ? points : 0;
				totalScore += value;
				const section = checked.dataset.section ?? '';
				bySection.set(section, (bySection.get(section) ?? 0) + value);
			});

			const percent = Math.round((totalScore / Math.max(1, maxScore)) * 100);
			const score = result.querySelector<HTMLElement>('[data-rg-score]')!;
			score.textContent = '0';
			const barUpdates: Array<{ bar: HTMLElement; width: string; delay: string }> = [];

			let dominantKey = '';
			let dominantRatio = -1;
			result.querySelectorAll<HTMLElement>('[data-rg-section]').forEach((card) => {
				const key = card.dataset.rgSection ?? '';
				const max = Number(card.dataset.max) || 1;
				const value = bySection.get(key) ?? 0;
				const ratio = Math.min(1, Math.max(0, value / max));
				const sectionPercent = Math.round(ratio * 100);
				const levelRatio = sectionPercent / 100;

				if (ratio > dominantRatio) {
					dominantRatio = ratio;
					dominantKey = key;
				}

				const scoreEl = card.querySelector<HTMLElement>('[data-rg-section-score]');
				if (scoreEl) scoreEl.textContent = String(sectionPercent);

				const levels = Array.from(card.querySelectorAll<HTMLElement>('[data-rg-level]'));
				const level =
					levels.find((l) => levelRatio <= Number(l.dataset.upTo)) ?? levels[levels.length - 1];
				levels.forEach((l) => {
					l.hidden = l !== level;
				});
				card.dataset.tone = level?.dataset.tone ?? 'low';
				card.querySelectorAll<HTMLElement>('[data-rg-sentiment]').forEach((icon) => {
					icon.toggleAttribute('hidden', icon.dataset.tone !== card.dataset.tone);
				});

				const dominantLabel = card.querySelector<HTMLElement>('[data-rg-dominant-label]');
				if (dominantLabel) dominantLabel.hidden = true;

				const bar = card.querySelector<HTMLElement>('.rg-bar');
				if (bar) {
					barUpdates.push({
						bar,
						width: `${ratio * 100}%`,
						delay: `${180 + barUpdates.length * 120}ms`,
					});
				}
			});

			if (dominantKey) {
				const dominantCard = result.querySelector<HTMLElement>(`[data-rg-section="${dominantKey}"]`);
				const dominantLabel = dominantCard?.querySelector<HTMLElement>('[data-rg-dominant-label]');
				if (dominantLabel) dominantLabel.hidden = false;
				showDimension('data-rg-dimension', dominantKey);
				showDimension('data-rg-blur-dimension', dominantKey);
				showDimension('data-rg-transition', dominantKey);
			}

			const blocks = Array.from(result.querySelectorAll<HTMLElement>('[data-rg-profile]'));
			const match =
				blocks.find(
					(b) => percent >= Number(b.dataset.min) && percent <= Number(b.dataset.max),
				) ?? blocks[blocks.length - 1];
			blocks.forEach((b) => {
				b.hidden = b !== match;
			});
			const overallTone = match?.dataset.tone ?? 'mid';
			const badge = result.querySelector<HTMLElement>('[data-rg-badge]')!;
			badge.textContent = match?.dataset.label ?? '';
			badge.dataset.tone = overallTone;
			result.querySelector<HTMLElement>('[data-rg-total]')!.dataset.tone = overallTone;

			const ratio = (percent - minScore) / Math.max(1, 100 - minScore);
			const marker = result.querySelector<HTMLElement>('[data-rg-marker]')!;
			const markerPosition = `${Math.min(100, Math.max(0, ratio * 100))}%`;
			marker.dataset.tone = overallTone;

			form.hidden = true;
			progress.hidden = true;
			result.hidden = false;
			result.dataset.revealed = 'false';
			document.querySelector<HTMLElement>('[data-rg-intro]')?.setAttribute('hidden', '');
			document.querySelector<HTMLElement>('[data-rg-info]')?.setAttribute('hidden', '');
			const bookingMount = result.querySelector<HTMLElement>('[data-rg-booking-mount]');
			if (bookingMount && !bookingMount.querySelector('iframe')) {
				const iframe = document.createElement('iframe');
				iframe.id = 'dJzUTOt5Rfugql6aVt4K_1789894663085';
				iframe.src = 'https://api.leadconnectorhq.com/widget/booking/dJzUTOt5Rfugql6aVt4K';
				iframe.title = 'Réservation d’un bilan';
				iframe.allow = 'payment';
				iframe.setAttribute('scrolling', 'no');
				iframe.style.width = '100%';
				iframe.style.border = 'none';
				iframe.style.overflow = 'hidden';
				iframe.style.minHeight = '600px';
				bookingMount.appendChild(iframe);

				const embed = document.createElement('script');
				embed.src = 'https://link.msgsndr.com/js/form_embed.js';
				embed.async = true;
				embed.dataset.rgBookingEmbed = '';
				bookingMount.appendChild(embed);
			}
			const revealResult = () => {
				result.dataset.revealed = 'true';
				window.requestAnimationFrame(() => {
					barUpdates.forEach(({ bar, width, delay }) => {
						bar.style.transitionDelay = delay;
						bar.style.width = width;
					});
					marker.style.left = markerPosition;

					if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
						score.textContent = String(percent);
						return;
					}

					const duration = 700;
					const startedAt = performance.now();
					const updateScore = (now: number) => {
						const progress = Math.min(1, (now - startedAt) / duration);
						const eased = 1 - Math.pow(1 - progress, 3);
						score.textContent = String(Math.round(percent * eased));
						if (progress < 1) window.requestAnimationFrame(updateScore);
					};
					window.requestAnimationFrame(updateScore);
				});
			};
			root.scrollIntoView({ block: 'start', behavior: 'smooth' });
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) revealResult();
			else window.setTimeout(revealResult, 520);
			result.querySelector<HTMLElement>('#rg-result-title')?.focus({ preventScroll: true });

			trackUmami('quiz_completed');
		};

		const goNext = () => {
			if (!isAnswered(steps[current])) return;
			const next = findNext(current, 1);
			if (next >= steps.length) showResult();
			else goTo(next);
		};

		form.addEventListener('pointerdown', () => {
			lastPointerAt = Date.now();
		});

		form.addEventListener('change', (e) => {
			const target = e.target;
			if (!(target instanceof HTMLInputElement) || target.type !== 'radio') return;
			if (!startedTracked) {
				startedTracked = true;
				trackUmami('quiz_started');
			}
			syncSkipped();
			render(false);
			// Avance automatique au premier choix d'une étape seulement, pour ne pas
			// piéger quelqu'un qui revient en arrière relire sa réponse.
			if (autoAdvanced.has(current)) return;
			// Et uniquement au clic / toucher : au clavier, les flèches font défiler
			// les options une à une, il ne faut pas avancer dès la première.
			if (Date.now() - lastPointerAt > 500) return;
			autoAdvanced.add(current);
			window.setTimeout(() => {
				if (steps[current].contains(target)) goNext();
			}, 260);
		});

		nextBtn.addEventListener('click', goNext);

		root.addEventListener('click', (e) => {
			const trigger = (e.target as HTMLElement).closest('[data-rg-scroll-booking]');
			if (!trigger) return;
			const booking = result.querySelector<HTMLElement>('[data-rg-booking]');
			if (!booking) return;
			trackUmami('appointment_clicked');
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			booking.scrollIntoView({
				block: 'start',
				behavior: reduceMotion ? 'auto' : 'smooth',
			});
		});

		// Le formulaire n'a pas de bouton submit (pour qu'aucune soumission ne soit
		// possible sans JavaScript) : on gère « Entrée » nous-mêmes.
		form.addEventListener('keydown', (e) => {
			if (e.key !== 'Enter') return;
			// Sur un bouton, « Entrée » doit déclencher ce bouton, pas avancer.
			if (e.target instanceof HTMLButtonElement) return;
			e.preventDefault();
			goNext();
		});

		prevBtn.addEventListener('click', () => {
			const prev = findNext(current, -1);
			if (prev >= 0) goTo(prev);
		});

		result.querySelector<HTMLButtonElement>('[data-rg-restart]')?.addEventListener('click', () => {
			form.reset();
			autoAdvanced.clear();
			wasSkipping = false;
			startedTracked = false;
			resultShown = false;
			syncSkipped();
			result.hidden = true;
			result.removeAttribute('data-revealed');
			result.querySelector<HTMLElement>('[data-rg-score]')!.textContent = '—';
			result.querySelector<HTMLElement>('[data-rg-marker]')!.style.left = '0%';
			result.querySelectorAll<HTMLElement>('.rg-bar').forEach((bar) => {
				bar.style.width = '0%';
				bar.style.transitionDelay = '';
			});
			document.querySelector<HTMLElement>('[data-rg-intro]')?.removeAttribute('hidden');
			document.querySelector<HTMLElement>('[data-rg-info]')?.removeAttribute('hidden');
			form.hidden = false;
			progress.hidden = false;
			goTo(0);
		});

		// Activation du mode pas-à-pas.
		nojs.hidden = true;
		nav.hidden = false;
		progress.hidden = false;
		root.dataset.js = 'on';
		syncSkipped();
		render(false);
	});
</script>
