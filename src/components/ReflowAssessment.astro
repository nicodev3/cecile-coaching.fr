---
import { RotateCcw } from '@lucide/astro';
import TunnelCtaLink from './TunnelCtaLink.astro';
import { tieFrenchPunctuation } from '../utils/frenchTypography';
import { PROFILES, QUESTIONS, TOTAL_QUESTIONS } from '../data/reflow';
---

<div
	class="scroll-mt-28 rounded-3xl bg-(--surface-container-low) p-4 ring-1 ring-(--outline-variant)/60 sm:p-8"
	data-rg-root
	data-total={String(TOTAL_QUESTIONS)}
>
	{/* ---------- Progression (activée par le script) ---------- */}
	<div class="mb-6" data-rg-progress hidden>
		<div class="flex items-baseline justify-between gap-4">
			<p class="text-sm font-semibold tracking-[0.18em] text-(--primary-container)" data-rg-progress-label>
				QUESTION 1 SUR {TOTAL_QUESTIONS}
			</p>
			<p class="text-sm text-(--secondary)" data-rg-progress-section>{QUESTIONS[0].progressLabel}</p>
		</div>
		<div
			class="mt-3 h-2 overflow-hidden rounded-full bg-(--surface-container-high)"
			role="progressbar"
			aria-valuemin="1"
			aria-valuemax={TOTAL_QUESTIONS}
			aria-valuenow="1"
			aria-label="Progression dans le questionnaire"
			data-rg-progressbar
		>
			<div
				class="h-full rounded-full bg-(--primary) transition-[width] duration-500 ease-out motion-reduce:transition-none"
				style={`width: ${100 / TOTAL_QUESTIONS}%`}
				data-rg-progress-fill
			>
			</div>
		</div>
		<p class="mt-2 text-sm font-medium text-(--primary)" data-rg-remaining hidden></p>
		<p class="sr-only" aria-live="polite" data-rg-live></p>
	</div>

	{/* ---------- Questionnaire ---------- */}
	<form data-rg-form novalidate>
		{
			QUESTIONS.map((q) => (
				<fieldset
					class="rg-step border-0 p-0"
					data-rg-step
					data-qid={q.id}
					data-number={String(q.number)}
					data-section-label={q.progressLabel}
				>
					<legend
						class="mb-1 w-full rounded-lg text-xl leading-snug font-semibold text-(--on-surface) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--primary) sm:text-2xl"
						tabindex="-1"
					>
						<span class="mr-2 text-(--primary-container)">{q.number}.</span>
						{tieFrenchPunctuation(q.label)}
					</legend>

					{q.hint && <p class="mb-1 text-sm leading-relaxed text-(--secondary)">{tieFrenchPunctuation(q.hint)}</p>}

					<div class="mt-5 grid gap-2.5">
						{q.options.map((o, optionIndex) => (
							<label class="group relative flex cursor-pointer items-start gap-3 rounded-2xl bg-(--surface-container-lowest) px-4 py-3.5 ring-1 ring-(--outline-variant) transition hover:ring-(--primary)/40 has-checked:bg-(--primary-fixed)/35 has-checked:ring-2 has-checked:ring-(--primary) has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-(--primary) motion-reduce:transition-none">
								<input
									type="radio"
									class="sr-only"
									name={q.id}
									value={String(optionIndex)}
									data-label={tieFrenchPunctuation(o.label)}
								/>
								<span
									class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full ring-1 ring-(--outline)/40 transition group-has-checked:ring-2 group-has-checked:ring-(--primary) motion-reduce:transition-none"
									aria-hidden="true"
								>
									<span class="size-2.5 rounded-full bg-(--primary) opacity-0 transition group-has-checked:opacity-100 motion-reduce:transition-none" />
								</span>
								<span class="text-base leading-snug text-(--on-surface) group-has-checked:font-semibold">
									{tieFrenchPunctuation(o.label)}
								</span>
							</label>
						))}
					</div>
				</fieldset>
			))
		}

		{/* ---------- Navigation (activée par le script) ---------- */}
		<div class="mt-7 flex items-center justify-between gap-3" data-rg-nav hidden>
			<button
				type="button"
				class="inline-flex items-center justify-center rounded-full border border-(--outline-variant) bg-(--surface-container-lowest) px-5 py-2.5 text-base font-medium text-(--secondary) transition hover:text-(--primary) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--primary) disabled:pointer-events-none disabled:opacity-40 motion-reduce:transition-none"
				data-rg-prev
			>
				Précédent
			</button>
			<button
				type="button"
				class="inline-flex items-center justify-center rounded-full bg-(--primary) px-7 py-3 text-base font-medium text-(--on-primary) transition hover:bg-(--primary-container) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--primary) disabled:pointer-events-none disabled:opacity-40 motion-reduce:transition-none"
				data-rg-next
				disabled
			>
				Suivant
			</button>
		</div>

		<p class="mt-7 rounded-2xl bg-(--surface-container-lowest) px-5 py-4 text-sm leading-relaxed text-(--secondary)" data-rg-nojs>
			Active JavaScript pour parcourir le questionnaire et découvrir ton profil Re-flow.
		</p>
	</form>

	{/* ---------- Déblocage du résultat ---------- */}
	<section data-rg-gate hidden aria-labelledby="rg-gate-title">
		<div class="text-center">
			<p class="text-sm font-semibold tracking-[0.18em] text-(--primary-container)">TON PROFIL RE-FLOW</p>
			<h2
				id="rg-gate-title"
				class="mt-3 rounded-lg text-3xl font-semibold text-(--on-surface) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--primary) sm:text-4xl"
				tabindex="-1"
			>
				Ton profil est prêt !
			</h2>
			<p
				class="mt-4 text-2xl font-semibold text-(--primary) sm:text-3xl"
				data-rg-gate-profile
				hidden
			>
			</p>
			<p class="mx-auto mt-4 max-w-lg text-base leading-relaxed text-(--secondary)">
				Laisse tes coordonnées pour voir le détail de ton profil et, si tu le souhaites, réserver ton bilan offert avec Cécile.
			</p>
		</div>

		<form class="mx-auto mt-8 max-w-lg space-y-4" data-rg-lead-form novalidate>
			<div class="sr-only" aria-hidden="true">
				<label for="rg-lead-company">Ne pas remplir</label>
				<input
					type="text"
					id="rg-lead-company"
					name="company"
					tabindex="-1"
					autocomplete="off"
				/>
			</div>

			<div class="grid gap-4 sm:grid-cols-2">
				<div class="space-y-2">
					<label for="rg-lead-first-name" class="text-sm font-semibold text-(--on-surface)">
						Prénom <span class="text-(--secondary)">*</span>
					</label>
					<input
						type="text"
						id="rg-lead-first-name"
						name="firstName"
						autocomplete="given-name"
						required
						maxlength="80"
						class="w-full rounded-xl border-none bg-(--surface-container-lowest) p-4 text-(--on-surface) ring-1 ring-(--outline-variant) transition focus:ring-2 focus:ring-(--primary) focus:outline-none"
					/>
				</div>
				<div class="space-y-2">
					<label for="rg-lead-last-name" class="text-sm font-semibold text-(--on-surface)">
						Nom <span class="text-(--secondary)">*</span>
					</label>
					<input
						type="text"
						id="rg-lead-last-name"
						name="lastName"
						autocomplete="family-name"
						required
						maxlength="80"
						class="w-full rounded-xl border-none bg-(--surface-container-lowest) p-4 text-(--on-surface) ring-1 ring-(--outline-variant) transition focus:ring-2 focus:ring-(--primary) focus:outline-none"
					/>
				</div>
			</div>

			<div class="space-y-2">
				<label for="rg-lead-email" class="text-sm font-semibold text-(--on-surface)">
					Email <span class="text-(--secondary)">*</span>
				</label>
				<input
					type="email"
					id="rg-lead-email"
					name="email"
					autocomplete="email"
					required
					maxlength="254"
					class="w-full rounded-xl border-none bg-(--surface-container-lowest) p-4 text-(--on-surface) ring-1 ring-(--outline-variant) transition focus:ring-2 focus:ring-(--primary) focus:outline-none"
				/>
			</div>

			<div class="space-y-2">
				<label for="rg-lead-phone" class="text-sm font-semibold text-(--on-surface)">
					Téléphone <span class="text-(--secondary)">*</span>
				</label>
				<input
					type="tel"
					id="rg-lead-phone"
					name="phone"
					autocomplete="tel"
					inputmode="tel"
					required
					placeholder="06 12 34 56 78"
					aria-describedby="rg-lead-phone-hint"
					class="w-full rounded-xl border-none bg-(--surface-container-lowest) p-4 text-(--on-surface) ring-1 ring-(--outline-variant) transition focus:ring-2 focus:ring-(--primary) focus:outline-none"
				/>
				<p id="rg-lead-phone-hint" class="text-sm leading-relaxed text-(--secondary)">
					Vérifie que le numéro est correct. Indispensable pour préparer ton bilan offert.
				</p>
			</div>

			<label class="flex items-start gap-3 text-sm leading-relaxed text-(--secondary)">
				<input
					type="checkbox"
					name="consent"
					required
					class="mt-1 size-4 shrink-0 accent-(--primary)"
				/>
				<span>
					J’accepte que mes coordonnées et mes réponses servent à afficher mon profil et à me recontacter au sujet de Re-flow.{' '}
					<a
						href="/politique-de-confidentialite/"
						class="font-semibold text-(--primary) underline underline-offset-2"
					>
						Politique de confidentialité
					</a>
				</span>
			</label>

			<p class="text-sm leading-relaxed text-(--error)" data-rg-lead-error hidden role="alert"></p>

			<button
				type="submit"
				class="inline-flex w-full items-center justify-center rounded-full bg-(--primary) px-7 py-3 text-base font-medium text-(--on-primary) transition hover:bg-(--primary-container) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--primary) disabled:pointer-events-none disabled:opacity-40 motion-reduce:transition-none"
				data-rg-lead-submit
			>
				Voir le détail de mon profil
			</button>
		</form>
	</section>

	{/* ---------- Résultat personnalisé : aucun score affiché ---------- */}
	<section data-rg-result hidden aria-labelledby="rg-result-title">
		<div class="text-center">
			<p class="text-sm font-semibold tracking-[0.18em] text-(--primary-container)">TON PROFIL RE-FLOW</p>
			<h2 id="rg-result-title" tabindex="-1" class="mt-3 rounded-lg text-4xl font-semibold text-(--primary) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--primary) sm:text-5xl" data-rg-profile-name></h2>
		</div>
		{PROFILES.map((profile) => (
			<div data-rg-profile={profile.key} hidden>
				<p class="mt-6 text-xl leading-relaxed font-semibold text-(--on-surface)">{profile.summary}</p>
			</div>
		))}
		<div
			class="mt-8 scroll-mt-28 rounded-2xl border-2 border-(--primary) bg-(--surface-container-lowest) px-5 py-6 sm:px-8 sm:py-8"
			data-rg-booking
		>
			<div class="text-center">
				<p class="text-xs font-semibold tracking-[0.18em] text-(--primary) uppercase">Bilan offert — Re-flow</p>
				<h3
					id="rg-booking-title"
					tabindex="-1"
					class="mt-2 rounded-lg text-xl leading-snug font-semibold text-(--on-surface) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--primary) sm:text-2xl"
				>
					Réserve ton bilan pour relire ce profil
				</h3>
				<p class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-(--secondary)">
					Un échange gratuit avec Cécile pour relire ce résultat et voir si Re-flow est fait pour toi.
				</p>
			</div>
			<div class="mt-6 min-h-150" data-rg-booking-mount></div>
		</div>
		{PROFILES.map((profile) => (
			<div data-rg-profile-more={profile.key} hidden>
				<div class="mt-10 space-y-4 text-base leading-relaxed text-(--secondary)">
					{profile.intro.map((text) => <p>{text}</p>)}
				</div>
				<div class="mt-8 rounded-2xl bg-(--surface-container-lowest) p-5 sm:p-6">
					<h3 class="text-lg font-semibold text-(--primary)">Ta priorité aujourd’hui</h3>
					<p class="mt-3 text-lg font-semibold text-(--on-surface)">{profile.priority}</p>
					{profile.guidance.map((text) => <p class="mt-3 leading-relaxed text-(--secondary)">{text}</p>)}
				</div>
				<h3 class="mt-10 text-xl font-semibold text-(--on-surface)">C’est justement l’approche de Re-flow</h3>
				{profile.approach.map((text) => <p class="mt-3 leading-relaxed text-(--secondary)">{text}</p>)}
				<div class="mt-8 rounded-2xl bg-(--secondary-container)/40 p-5 text-(--on-secondary-container) sm:p-6">
					<h3 class="text-lg font-semibold">Ton petit pas du jour</h3>
					{profile.smallStep.map((text) => <p class="mt-3 leading-relaxed">{text}</p>)}
				</div>
				<p class="mt-8 text-center text-lg font-semibold text-(--on-surface)">{profile.invitation}</p>
			</div>
		))}
		<div class="mt-10 border-t border-(--outline-variant) pt-8 text-center">
			<p class="leading-relaxed text-(--secondary)">
				Tu préfères découvrir le programme avant le rendez-vous&nbsp;?
			</p>
			<TunnelCtaLink
				campaign="quiz-result"
				class="mt-4 inline-flex items-center justify-center rounded-full border border-(--outline-variant) bg-(--surface-container-lowest) px-6 py-3 text-base font-medium text-(--primary) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--primary)"
			>
				Voir le programme Re-flow
			</TunnelCtaLink>
		</div>
		<p class="mt-8 rounded-2xl bg-(--secondary-container)/40 px-5 py-4 text-sm leading-relaxed text-(--on-secondary-container)">
			Ce questionnaire est un outil d’orientation et de réflexion. Il ne constitue pas une évaluation médicale et ne remplace pas l’avis d’un professionnel de santé.
		</p>
		<div class="mt-8 text-center">
			<button type="button" class="inline-flex items-center justify-center gap-2 rounded-full border border-(--outline-variant) bg-(--surface-container-lowest) px-6 py-3 text-base font-medium text-(--primary) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--primary)" data-rg-restart>
				<RotateCcw class="size-4" aria-hidden="true" stroke-width={2} /> Refaire le test
			</button>
		</div>
	</section>
</div>

<style>
	[data-rg-root][data-js='on'] .rg-step:not([data-current]) {
		display: none;
	}
</style>

<script>
	import { ANALYTICS_EVENTS, quizQuestionAnsweredEvent } from '../config/analyticsEvents';
	import { scoreQuiz, type SubmittedAnswer } from '../data/reflow';
	import { normalizeFrenchPhone } from '../utils/frenchPhone';

	const trackUmami = (name: string) => {
		const umami = (window as unknown as { umami?: { track?: (n: string) => void } }).umami;
		umami?.track?.(name);
	};

	type Fbq = ((...args: unknown[]) => void) & { callMethod?: (...args: unknown[]) => void; queue?: unknown[] };
	const trackMeta = (event: string, params?: Record<string, unknown>, custom = false) => {
		const fbq = (window as unknown as { fbq?: Fbq }).fbq;
		if (typeof fbq !== 'function') return;
		fbq(custom ? 'trackCustom' : 'track', event, params);
	};

	const QUIZ_CONTENT = { content_name: 'quiz_reflow', content_category: 'quiz' } as const;

	document.querySelectorAll<HTMLElement>('[data-rg-root]').forEach((root) => {
		const form = root.querySelector<HTMLFormElement>('[data-rg-form]')!;
		const result = root.querySelector<HTMLElement>('[data-rg-result]')!;
		const progress = root.querySelector<HTMLElement>('[data-rg-progress]')!;
		const remainingLabel = root.querySelector<HTMLElement>('[data-rg-remaining]')!;
		const gate = root.querySelector<HTMLElement>('[data-rg-gate]')!;
		const gateProfile = root.querySelector<HTMLElement>('[data-rg-gate-profile]')!;
		const booking = root.querySelector<HTMLElement>('[data-rg-booking]')!;
		const leadForm = root.querySelector<HTMLFormElement>('[data-rg-lead-form]')!;
		const leadError = root.querySelector<HTMLElement>('[data-rg-lead-error]')!;
		const leadSubmit = root.querySelector<HTMLButtonElement>('[data-rg-lead-submit]')!;
		const prevBtn = root.querySelector<HTMLButtonElement>('[data-rg-prev]')!;
		const nextBtn = root.querySelector<HTMLButtonElement>('[data-rg-next]')!;
		const steps = Array.from(root.querySelectorAll<HTMLFieldSetElement>('[data-rg-step]'));
		const autoAdvanced = new Set<number>();
		const answeredTracked = new Set<number>();
		let current = 0;
		let lastPointerAt = 0;
		let viewedTracked = false;
		let ctaTracked = false;
		let bookingViewedTracked = false;
		let startedTracked = false;
		let leadSending = false;
		let advanceTimer: number | undefined;

		const trackQuizViewed = () => {
			if (viewedTracked) return;
			viewedTracked = true;
			trackUmami(ANALYTICS_EVENTS.quizViewed);
			trackMeta('ViewContent', QUIZ_CONTENT);
		};
		const trackQuizCtaClicked = () => {
			if (ctaTracked) return;
			ctaTracked = true;
			trackUmami(ANALYTICS_EVENTS.quizCtaClicked);
		};
		const trackBookingViewed = () => {
			if (bookingViewedTracked || result.hidden) return;
			bookingViewedTracked = true;
			trackUmami(ANALYTICS_EVENTS.bookingViewed);
			trackMeta('BookingViewed', QUIZ_CONTENT, true);
		};

		const mountCalendar = (lead: {
			firstName: string;
			lastName: string;
			email: string;
			phone: string;
		}) => {
			const bookingMount = result.querySelector<HTMLElement>('[data-rg-booking-mount]');
			if (!bookingMount || bookingMount.querySelector('iframe')) return;
			const bookingUrl = new URL('https://api.leadconnectorhq.com/widget/booking/dJzUTOt5Rfugql6aVt4K');
			bookingUrl.searchParams.set('first_name', lead.firstName);
			bookingUrl.searchParams.set('last_name', lead.lastName);
			bookingUrl.searchParams.set('email', lead.email);
			bookingUrl.searchParams.set('phone', lead.phone);

			const iframe = document.createElement('iframe');
			iframe.id = 'dJzUTOt5Rfugql6aVt4K_1789894663085';
			iframe.src = bookingUrl.toString();
			iframe.title = 'Réservation d’un bilan';
			iframe.allow = 'payment';
			iframe.setAttribute('scrolling', 'no');
			iframe.style.width = '100%';
			iframe.style.border = 'none';
			iframe.style.overflow = 'hidden';
			iframe.style.minHeight = '600px';
			bookingMount.appendChild(iframe);

			const embed = document.createElement('script');
			embed.src = 'https://link.msgsndr.com/js/form_embed.js';
			embed.async = true;
			embed.dataset.rgBookingEmbed = '';
			bookingMount.appendChild(embed);
		};


		const selected = (step: HTMLFieldSetElement) =>
			step.querySelector<HTMLInputElement>('input:checked');
		const readAnswers = (): SubmittedAnswer[] =>
			steps.flatMap((step) => {
				const radio = selected(step);
				return radio ? [{ id: step.dataset.qid!, optionIndex: Number(radio.value) }] : [];
			});
		const scrollToQuiz = () =>
			root.scrollIntoView({
				block: 'start',
				behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
			});
		const scrollToBooking = () =>
			booking.scrollIntoView({
				block: 'start',
				behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
			});
		const showProfile = (profileKey: string) => {
			result.querySelectorAll<HTMLElement>('[data-rg-profile]').forEach((block) => {
				block.hidden = block.dataset.rgProfile !== profileKey;
			});
			result.querySelectorAll<HTMLElement>('[data-rg-profile-more]').forEach((block) => {
				block.hidden = block.dataset.rgProfileMore !== profileKey;
			});
		};
		const render = (focus = true) => {
			steps.forEach((step, index) => step.toggleAttribute('data-current', index === current));
			root.querySelector<HTMLElement>('[data-rg-progress-label]')!.textContent =
				`QUESTION ${current + 1} SUR ${steps.length}`;
			root.querySelector<HTMLElement>('[data-rg-progress-section]')!.textContent =
				steps[current].dataset.sectionLabel!;
			root.querySelector('[data-rg-progressbar]')!.setAttribute('aria-valuenow', String(current + 1));
			root.querySelector<HTMLElement>('[data-rg-progress-fill]')!.style.width =
				`${((current + 1) / steps.length) * 100}%`;
			const remaining = steps.length - current;
			if (remaining <= 3) {
				remainingLabel.hidden = false;
				remainingLabel.textContent =
					remaining === 1 ? 'Dernière question' : `Plus que ${remaining} questions`;
			} else {
				remainingLabel.hidden = true;
				remainingLabel.textContent = '';
			}
			root.querySelector<HTMLElement>('[data-rg-live]')!.textContent =
				`Question ${current + 1} sur ${steps.length}.`;
			prevBtn.disabled = current === 0;
			nextBtn.disabled = !selected(steps[current]);
			nextBtn.textContent = current === steps.length - 1 ? 'Découvrir mon profil' : 'Suivant';
			if (!focus) return;
			steps[current].querySelector('legend')?.focus({ preventScroll: true });
			const headerHeight = document.querySelector('header')?.getBoundingClientRect().height ?? 0;
			if (root.getBoundingClientRect().top < headerHeight + 8) scrollToQuiz();
		};
		const goNext = () => {
			window.clearTimeout(advanceTimer);
			if (form.hidden || !selected(steps[current])) return;
			if (current < steps.length - 1) {
				current++;
				render();
				return;
			}
			if (readAnswers().length !== steps.length) return;
			const scored = scoreQuiz(readAnswers());
			if (scored) {
				gateProfile.textContent = scored.profile.label;
				gateProfile.hidden = false;
			} else {
				gateProfile.textContent = '';
				gateProfile.hidden = true;
			}
			form.hidden = true;
			progress.hidden = true;
			gate.hidden = false;
			document.querySelector('[data-rg-intro]')?.setAttribute('hidden', '');
			document.querySelector('[data-rg-info]')?.setAttribute('hidden', '');
			scrollToQuiz();
			gate.querySelector<HTMLElement>('#rg-gate-title')?.focus({ preventScroll: true });
			trackUmami(ANALYTICS_EVENTS.quizCompleted);
			trackMeta('QuizCompleted', QUIZ_CONTENT, true);
		};
		form.addEventListener('submit', (event) => {
			event.preventDefault();
			goNext();
		});
		form.addEventListener('pointerdown', () => {
			lastPointerAt = Date.now();
		});
		// Les flèches du clavier doivent permettre de parcourir les quatre choix.
		form.addEventListener('keydown', (event) => {
			lastPointerAt = 0;
			window.clearTimeout(advanceTimer);
			if (event.key !== 'Enter' || event.target instanceof HTMLButtonElement) return;
			event.preventDefault();
			goNext();
		});
		form.addEventListener('change', (event) => {
			const target = event.target;
			if (!(target instanceof HTMLInputElement) || target.type !== 'radio') return;
			if (!startedTracked) {
				startedTracked = true;
				trackUmami(ANALYTICS_EVENTS.quizStarted);
				trackMeta('QuizStarted', QUIZ_CONTENT, true);
			}
			// Un jalon par question répondue, une seule fois par passage dans le quiz.
			// Ni le choix, ni le texte de la réponse ne sont envoyés à Umami.
			if (!answeredTracked.has(current)) {
				answeredTracked.add(current);
				trackUmami(quizQuestionAnsweredEvent(current + 1));
			}
			render(false);
			if (autoAdvanced.has(current) || Date.now() - lastPointerAt > 500) return;
			autoAdvanced.add(current);
			advanceTimer = window.setTimeout(() => {
				if (steps[current].contains(target)) goNext();
			}, 260);
		});
		nextBtn.addEventListener('click', goNext);
		prevBtn.addEventListener('click', () => {
			window.clearTimeout(advanceTimer);
			if (current > 0) {
				current--;
				render();
			}
		});

		const showError = (message: string) => {
			leadError.textContent = message;
			leadError.hidden = false;
		};
		const PHONE_ERROR =
			'Indique un numéro français à 10 chiffres, comme 06 12 34 56 78, ou au format +33.';
		leadForm.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (leadSending || gate.hidden) return;
			leadError.hidden = true;
			const phoneField = leadForm.querySelector<HTMLInputElement>('#rg-lead-phone');
			if (!leadForm.reportValidity()) {
				trackUmami(ANALYTICS_EVENTS.quizLeadInvalid);
				if (phoneField && document.activeElement === phoneField && phoneField.validity.valueMissing) {
					showError(PHONE_ERROR);
				}
				return;
			}
			const data = new FormData(leadForm);
			const firstName = String(data.get('firstName') ?? '').trim();
			const lastName = String(data.get('lastName') ?? '').trim();
			const email = String(data.get('email') ?? '').trim();
			const phone = normalizeFrenchPhone(String(data.get('phone') ?? ''));
			const company = String(data.get('company') ?? '');
			const consent = data.get('consent') === 'on';
			if (!phone) {
				showError(PHONE_ERROR);
				phoneField?.focus();
				trackUmami(ANALYTICS_EVENTS.quizLeadInvalid);
				return;
			}
			if (!firstName || !lastName || !email || !consent || company.trim()) {
				showError('Indique ton prénom, ton nom, un email valide et coche la case pour continuer.');
				trackUmami(ANALYTICS_EVENTS.quizLeadInvalid);
				return;
			}
			const answers = readAnswers();
			const scored = scoreQuiz(answers);
			if (!scored) {
				showError('Il manque des réponses. Recharge la page pour recommencer.');
				return;
			}
			leadSending = true;
			trackUmami(ANALYTICS_EVENTS.quizLeadAttempted);
			leadSubmit.disabled = true;
			leadSubmit.textContent = 'Envoi…';
			try {
				const response = await fetch(import.meta.env.DEV ? '/api/reflow-lead/' : '/api/reflow-lead', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
					body: JSON.stringify({ firstName, lastName, email, phone, consent, company, answers }),
				});
				if (response.status === 400) {
					showError('Indique ton prénom, ton nom, un email valide et coche la case pour continuer.');
					trackUmami(ANALYTICS_EVENTS.quizLeadInvalid);
					return;
				}
				if (!response.ok) throw new Error('lead');
				trackUmami(ANALYTICS_EVENTS.leadSubmitted);
				trackMeta('Lead', QUIZ_CONTENT);
				root.querySelector<HTMLElement>('[data-rg-profile-name]')!.textContent = scored.profile.label;
				showProfile(scored.profile.key);
				gate.hidden = true;
				result.hidden = false;
				mountCalendar({ firstName, lastName, email, phone });
				scrollToBooking();
				booking.querySelector<HTMLElement>('#rg-booking-title')?.focus({ preventScroll: true });
				trackBookingViewed();
			} catch {
				trackUmami(ANALYTICS_EVENTS.quizLeadFailed);
				showError(
					'L’envoi n’a pas abouti. Tes réponses sont conservées sur cette page : tu peux réessayer.',
				);
			} finally {
				leadSending = false;
				leadSubmit.disabled = false;
				leadSubmit.textContent = leadError.hidden ? 'Voir le détail de mon profil' : 'Réessayer';
			}
		});
		const openQuiz = () => {
			document.querySelector('[data-rg-intro]')?.setAttribute('hidden', '');
			document.querySelector('[data-rg-quiz-panel]')?.removeAttribute('hidden');
			scrollToQuiz();
			steps[0]?.querySelector('legend')?.focus({ preventScroll: true });
			trackQuizCtaClicked();
		};
		const closeQuizToIntro = () => {
			document.querySelector('[data-rg-intro]')?.removeAttribute('hidden');
			document.querySelector('[data-rg-info]')?.removeAttribute('hidden');
			document.querySelector('[data-rg-quiz-panel]')?.setAttribute('hidden', '');
		};

		document.querySelector('[data-rg-start]')?.addEventListener('click', openQuiz);

		root.querySelector('[data-rg-restart]')!.addEventListener('click', () => {
			window.clearTimeout(advanceTimer);
			form.reset();
			leadForm.reset();
			result.querySelector<HTMLElement>('[data-rg-booking-mount]')?.replaceChildren();
			autoAdvanced.clear();
			answeredTracked.clear();
			startedTracked = false;
			bookingViewedTracked = false;
			viewedTracked = false;
			ctaTracked = false;
			lastPointerAt = 0;
			current = 0;
			result.hidden = true;
			gate.hidden = true;
			gateProfile.hidden = true;
			gateProfile.textContent = '';
			leadError.hidden = true;
			leadSubmit.textContent = 'Voir le détail de mon profil';
			form.hidden = false;
			progress.hidden = false;
			closeQuizToIntro();
			render(false);
			trackQuizViewed();
		});
		root.querySelector<HTMLElement>('[data-rg-nojs]')!.hidden = true;
		root.querySelector<HTMLElement>('[data-rg-nav]')!.hidden = false;
		progress.hidden = false;
		root.dataset.js = 'on';
		render(false);

		const intro = document.querySelector('[data-rg-intro]');
		if (typeof IntersectionObserver === 'undefined') {
			trackQuizViewed();
		} else {
			const quizObserver = new IntersectionObserver(
				(entries) => {
					if (!entries.some((entry) => entry.isIntersecting)) return;
					trackQuizViewed();
					quizObserver.disconnect();
				},
				{ threshold: 0.35 },
			);
			quizObserver.observe(intro ?? root);

			const bookingObserver = new IntersectionObserver(
				(entries) => {
					if (!entries.some((entry) => entry.isIntersecting && entry.intersectionRatio > 0)) return;
					trackBookingViewed();
				},
				{ threshold: 0.4 },
			);
			bookingObserver.observe(booking);
		}
	});
</script>
