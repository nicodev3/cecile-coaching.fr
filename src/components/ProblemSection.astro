---
import {
	ArrowDown,
	BatteryLow,
	CircleGauge,
	Frown,
	PersonStanding,
	RefreshCw,
	Sprout,
	TrendingDown,
	Waypoints,
	Wind,
} from '@lucide/astro';

const cycle = [
	{
		title: 'Fatigue',
		desc: "Avec les douleurs chroniques l'énergie baisse, tu te sens fatiguée.",
		icon: BatteryLow,
	},
	{
		title: 'Moins de mouvement',
		desc: "Le corps est moins sollicité : tu deviens sédentaire.",
		icon: TrendingDown,
	},
	{
		title: 'Fonte de la masse musculaire',
		desc: "A cause de l'inactivité, la force et l'endurance diminuent peu à peu.",
		icon: PersonStanding,
	},
	{
		title: 'Découragement',
		desc: 'Tu perds confiance dans ton corps, et se remettre en mouvement devient difficile.',
		icon: Frown,
	},
];

const pillars = [
	{
		title: 'Selon ton énergie',
		desc: 'Des versions plus douces quand tu en as besoin.',
		icon: Wind,
	},
	{
		title: 'Progressivement',
		desc: 'Reconstruire la confiance sans brusquer le corps.',
		icon: Sprout,
	},
	{
		title: 'Cadre clair',
		desc: 'Savoir quoi faire pour ne pas se mettre en échec.',
		icon: CircleGauge,
	},
	{
		title: "L'objectif",
		desc: 'Refaire une place au mouvement durablement.',
		icon: Waypoints,
	},
];

const reveal =
	'opacity-0 translate-y-4 transition duration-700 ease-out will-change-transform will-change-opacity motion-reduce:transition-none data-[revealed=true]:opacity-100 data-[revealed=true]:translate-y-0';
---

<section
	id="methode"
	class={`py-20 sm:px-10 ${reveal}`}
	data-reveal
	data-revealed="false"
	aria-labelledby="problem-title"
>
	<div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
		<div class="mb-16 space-y-4 text-center">
			<h2 id="problem-title" class="text-3xl text-(--primary) sm:text-5xl">
				Sortir de l'engrenage
			</h2>
			<p class="mx-auto max-w-2xl text-lg leading-relaxed text-(--secondary)">
				Quand la fatigue s'installe, bouger moins semble protéger. Avec un accompagnement en ligne, nous pouvons
				inverser la tendance depuis chez toi.
			</p>
		</div>

		<div class="grid gap-6 lg:gap-8">
			<div class="flex flex-col rounded-xl bg-(--surface-container) p-6 sm:p-8">
				<h3 class="mb-8 text-2xl text-(--primary)">Le cercle vicieux du déconditionnement physique</h3>
				<div class="relative">
					<ol
						class="grid gap-8 sm:grid-cols-2 sm:gap-24"
						aria-label="Étapes du cercle vicieux du déconditionnement physique, qui se répètent en boucle"
					>
						{
							cycle.map((item, i) => (
								<li class={`relative flex flex-col gap-3 rounded-xl border border-(--outline-variant)/30 bg-(--surface)/60 p-5 ${i === 2 ? 'sm:order-4' : ''} ${i === 3 ? 'sm:order-3' : ''}`}>
									<div class="flex items-center gap-3">
										<div class="flex size-11 shrink-0 items-center justify-center rounded-full bg-(--primary)/10" aria-hidden="true">
											<item.icon class="size-6 text-(--primary-container)" stroke-width={1.75} />
										</div>
										<p class="text-base font-bold text-(--primary)">
											<span class="mr-1 text-(--primary-container)">{i + 1}.</span>{item.title}
										</p>
									</div>
									<p class="text-base leading-relaxed text-(--secondary)">{item.desc}</p>
									{i < cycle.length - 1 && (
										<span class="absolute top-full left-1/2 z-10 flex size-8 -translate-x-1/2 items-center justify-center text-(--primary) sm:hidden" aria-hidden="true">
											<ArrowDown class="size-5" stroke-width={2.5} />
										</span>
									)}
								</li>
							))
						}
					</ol>

					<!-- Boucle centrale (desktop) : quatre flèches en arc, sens horaire -->
				<div class="pointer-events-none absolute top-1/2 left-1/2 hidden size-28 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-(--surface-container) sm:flex" aria-hidden="true">
					<svg viewBox="-50 -50 100 100" class="absolute inset-0 size-full text-(--primary)"><circle r="40" fill="none" stroke="currentColor" stroke-opacity="0.12" stroke-width="1"/><path d="M11.0 -38.5A40 40 0 0 1 35.3 -18.8M38.5 11.0A40 40 0 0 1 18.8 35.3M-11.0 38.5A40 40 0 0 1 -35.3 18.8M-38.5 -11.0A40 40 0 0 1 -18.8 -35.3" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round"/><path d="M39.5 -10.8L29.6 -16.8L40.1 -22.5ZM10.8 39.5L16.8 29.6L22.5 40.1ZM-39.5 10.8L-29.6 16.8L-40.1 22.5ZM-10.8 -39.5L-16.8 -29.6L-22.5 -40.1Z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
					<span class="relative flex size-12 items-center justify-center rounded-full bg-(--primary)/10 text-(--primary)">
						<RefreshCw class="size-6" stroke-width={1.75} />
					</span>
				</div>

				<p class="mt-8 flex items-center justify-center gap-2 text-sm font-semibold text-(--primary) sm:hidden" aria-hidden="true">
						<RefreshCw class="size-4" stroke-width={2.5} /> Et ça recommence
					</p>
				</div>
				<p class="mt-8 text-center text-sm text-(--secondary)">
					Chaque tour du cercle renforce le suivant. Bonne nouvelle : il suffit d'agir sur un seul maillon pour l'inverser.
				</p>
			</div>

			<div class="group relative overflow-hidden rounded-xl bg-linear-to-br from-(--primary) via-(--primary) to-(--primary-container) p-8 text-(--on-primary) shadow-lg shadow-(--primary)/10 transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-(--primary)/20 sm:p-10">
				<div
					class="pointer-events-none absolute -top-24 right-0 size-64 rounded-full bg-(--primary-fixed)/10 blur-3xl transition duration-500 group-hover:scale-125"
					aria-hidden="true"
				/>
				<div class="relative z-10 flex h-full flex-col">
					<h3 class="text-3xl text-(--on-primary) sm:text-4xl">La solution RE-FLOW</h3>
					<div class="my-8 grid gap-3 sm:grid-cols-2 sm:gap-4 xl:grid-cols-4">
						{pillars.map((pillar) => (
							<div class="rounded-xl border border-(--primary-fixed)/20 bg-(--on-primary)/6 p-3 backdrop-blur-sm transition duration-300 hover:bg-(--on-primary)/12 sm:p-4">
								<div class="flex min-w-0 items-center gap-2.5 sm:gap-3">
									<div class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-(--primary-fixed)/15 text-(--primary-fixed)">
										<pillar.icon class="size-5" stroke-width={1.9} />
									</div>
									<h4 class="min-w-0 break-words text-sm leading-snug font-semibold text-(--primary-fixed)">
										{pillar.title}
									</h4>
								</div>
								<p class="mt-3 text-sm leading-relaxed text-(--on-primary-container)">{pillar.desc}</p>
							</div>
						))}
					</div>
					<a
						href="#programme"
						class="self-center rounded-full bg-(--surface) px-8 py-4 text-base font-semibold text-(--primary) transition hover:bg-(--primary-fixed)"
					>
						Découvrir la méthode en ligne
					</a>
				</div>
				<div
					class="pointer-events-none absolute -right-20 -bottom-20 size-80 rounded-full bg-(--primary-container)/30 blur-[80px]"
					aria-hidden="true"
				/>
			</div>
		</div>
	</div>
</section>
