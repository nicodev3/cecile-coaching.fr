---
import { ArrowDown, ArrowUp, BatteryLow, Frown, PersonStanding, TrendingDown } from '@lucide/astro';

const cycle = [
	{
		title: 'Fatigue',
		desc: "Avec les douleurs chroniques l'énergie baisse, tu te sens fatiguée ",
		icon: BatteryLow,
	},
	{
		title: 'Moins de mouvement',
		desc: "Le corps est moins sollicité : tu deviens sédentaire ",
		icon: TrendingDown,
	},
	{
		title: 'Fonte de la masse musculaire',
		desc: "A cause de l'inactivité, la force et l'endurance diminuent peu à peu.",
		icon: PersonStanding,
	},
	{
		title: 'Découragement',
		desc: 'Tu perds confiance dans ton corps, et se remettre en mouvement devient difficile.',
		icon: Frown,
	},
];

const pillars = [
	{
		title: 'Selon ton énergie',
		desc: 'Des versions plus douces quand tu en as besoin.',
	},
	{
		title: 'Progressivement',
		desc: 'Reconstruire la confiance sans brusquer le corps.',
	},
	{
		title: 'Cadre clair',
		desc: 'Savoir quoi faire pour ne pas se mettre en échec.',
	},
	{
		title: "L'objectif",
		desc: 'Refaire une place au mouvement durablement.',
	},
];

const reveal =
	'opacity-0 translate-y-4 transition duration-700 ease-out will-change-transform will-change-opacity motion-reduce:transition-none data-[revealed=true]:opacity-100 data-[revealed=true]:translate-y-0';
---

<section
	id="methode"
	class={`py-20 sm:px-10 ${reveal}`}
	data-reveal
	data-revealed="false"
	aria-labelledby="problem-title"
>
	<div class="mx-auto max-w-(--max-width-container) px-4 sm:px-6 lg:px-8">
		<div class="mb-16 space-y-4 text-center">
			<h2 id="problem-title" class="text-3xl text-(--primary) sm:text-5xl">
				Sortir de l'engrenage
			</h2>
			<p class="mx-auto max-w-2xl text-lg leading-relaxed text-(--secondary)">
				Quand la fatigue s'installe, bouger moins semble protéger. Avec un accompagnement en ligne, nous pouvons
				inverser la tendance depuis chez toi.
			</p>
		</div>

		<div class="grid gap-6 lg:grid-cols-2 lg:gap-8">
			<div class="flex flex-col rounded-xl bg-(--surface-container) p-6 sm:p-8">
				<h3 class="mb-8 text-2xl text-(--primary)">Le cercle vicieux du déconditionnement physique</h3>
				<div class="relative rounded-2xl border-2 border-dashed border-(--primary)/30 px-4 py-5 sm:px-6 sm:py-6">
					<div class="flex items-stretch gap-4 sm:gap-6">
						<div class="flex w-5 shrink-0 flex-col items-center text-(--primary)" aria-hidden="true">
							<ArrowUp class="h-5 w-5 shrink-0" stroke-width={2.5} />
							<div class="mt-0.5 w-0.5 flex-1 rounded-full bg-(--primary-container)"></div>
						</div>
						<ol
							class="min-w-0 flex-1 space-y-4 py-1"
							aria-label="Étapes du cercle vicieux du déconditionnement physique"
						>
							{
								cycle.map((item) => (
									<li class="flex items-start gap-4 rounded-lg border border-(--outline-variant)/30 bg-(--surface)/50 p-5">
										<div
											class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-(--primary)/10"
											aria-hidden="true"
										>
											<item.icon class="h-7 w-7 text-(--primary-container)" stroke-width={1.75} />
										</div>
										<div class="min-w-0 pt-0.5">
											<p class="text-base font-bold text-(--primary)">{item.title}</p>
											<p class="mt-1 text-base leading-relaxed text-(--secondary)">{item.desc}</p>
										</div>
									</li>
								))
							}
						</ol>
						<div class="flex w-5 shrink-0 flex-col items-center text-(--primary)" aria-hidden="true">
							<div class="mb-0.5 w-0.5 flex-1 rounded-full bg-(--primary-container)"></div>
							<ArrowDown class="h-5 w-5 shrink-0" stroke-width={2.5} />
						</div>
					</div>
				</div>
			</div>

			<div class="relative overflow-hidden rounded-xl bg-(--primary) p-8 text-(--on-primary) sm:p-10">
				<div class="relative z-10 flex h-full flex-col">
					<h3 class="text-3xl text-(--on-primary) sm:text-4xl">La solution RE-FLOW</h3>
					<div class="my-10 grid flex-1 auto-rows-fr gap-x-8 gap-y-6 sm:grid-cols-2">
						{pillars.map((pillar) => (
							<div class="flex flex-col justify-center border-t border-(--primary-fixed)/25 pt-4">
								<h4 class="text-lg text-(--primary-fixed)">{pillar.title}</h4>
								<p class="mt-2 leading-relaxed text-(--on-primary-container)">{pillar.desc}</p>
							</div>
						))}
					</div>
					<a
						href="#programme"
						class="self-start rounded-full bg-(--surface) px-8 py-4 text-base font-semibold text-(--primary) transition hover:bg-(--primary-fixed)"
					>
						Découvrir la méthode en ligne
					</a>
				</div>
				<div
					class="pointer-events-none absolute -right-20 -bottom-20 h-80 w-80 rounded-full bg-(--primary-container)/30 blur-[80px]"
					aria-hidden="true"
				/>
			</div>
		</div>
	</div>
</section>
