---
import { Image } from 'astro:assets';
import {
	Check,
	Play,
	FileText,
	Video,
	HeartPulse,
	MessagesSquare,
	CalendarDays,
	Download,
	Clock3,
	Music2,
	Gift,
} from '@lucide/astro';
import coachPortrait from '../assets/cecile-coach-portrait.webp';

const cards = [
	{
		title: 'Ressources',
		icon: Play,
		items: [
			'48 séances vidéo guidées, soit plus de 24 h de contenu.',
			'3 séances par semaine, à suivre chez toi.',
			'Une séance Zoom collective tous les 15 jours, en direct ou en replay.',
			'Des supports clairs pour garder le cap.',
		],
		visual: 'video',
	},
	{
		title: 'Coaching personnalisé',
		icon: Video,
		items: [
			'Un bilan forme personnalisé au début et à la fin.',
			'Un point individuel chaque semaine en visioconférence.',
			'Conseils personnalisés.',
			'Un accompagnement WhatsApp avec réponse sous 24 h.',
		],
		visual: 'visio',
	},
	{
		title: 'Bonus',
		icon: HeartPulse,
		items: [
			'Un audio de relaxation et un audio de respiration.',
			'Mini-séances express de 5-10 min.',
			'Playlists Spotify pour accompagner tes séances.',
			'Une nouvelle vidéo bonus chaque mois.',
			'Le guide PDF « Ma routine bien-être ».',
			'Un cadeau surprise !',
		],
		visual: 'bonus',
	},
];

const reveal =
	'opacity-0 translate-y-4 transition duration-700 ease-out will-change-transform will-change-opacity motion-reduce:transition-none data-[revealed=true]:opacity-100 data-[revealed=true]:translate-y-0';
---

<section
	class={`bg-(--surface-container-low) py-20 sm:px-10 ${reveal}`}
	data-reveal
	data-revealed="false"
	aria-labelledby="what-title"
>
	<div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
		<div class="mb-16 text-center">
			<h2 id="what-title" class="text-3xl text-(--primary) sm:text-5xl">
				Concrètement, tu reçois
			</h2>
			<p class="mt-4 text-(--secondary)">Un programme en ligne clair, progressif et adapté.</p>
		</div>

		<div class="grid gap-8 md:grid-cols-3">
			{cards.map((c) => (
				<div class="bento-card group flex flex-col overflow-hidden rounded-3xl bg-(--surface-container-lowest) shadow-sm ring-1 ring-black/5 transition-all hover:shadow-md hover:ring-black/10">
					<div class="relative flex h-60 w-full items-center justify-center overflow-hidden bg-linear-to-br from-(--sage)/35 via-(--paper) to-(--primary-container)/12 p-5">
						{/* Mockup Vidéo / PDF */}
						{c.visual === 'video' && (
							<div class="relative h-full w-full max-w-72">
								<div class="absolute top-1 right-0 w-4/5 overflow-hidden rounded-2xl bg-white p-2 shadow-lg ring-1 ring-black/6 transition-transform duration-500 group-hover:-translate-y-1">
									<div class="relative aspect-video overflow-hidden rounded-xl bg-(--sage)">
										<Image
											src={coachPortrait}
											alt="Aperçu d'une séance vidéo guidée par Cécile"
											class="size-full object-cover object-[50%_28%]"
											width={320}
											height={180}
										/>
										<div class="absolute inset-0 bg-linear-to-t from-black/45 via-transparent to-transparent"></div>
										<div class="absolute inset-0 flex items-center justify-center">
											<span class="flex size-11 items-center justify-center rounded-full bg-white/95 text-(--primary) shadow-md">
												<Play class="ml-0.5 size-5" fill="currentColor" stroke-width={1.5} />
											</span>
										</div>
										<span class="absolute right-2 bottom-2 rounded-md bg-black/65 px-1.5 py-0.5 text-[10px] font-semibold text-white">
											32:08
										</span>
									</div>
									<div class="px-1 pt-2 pb-1">
										<p class="text-xs font-semibold text-(--on-surface)">Mobilité douce · séance 1/48</p>
										<p class="mt-0.5 text-[10px] text-(--outline)">3 séances par semaine</p>
									</div>
								</div>
								<div class="absolute bottom-1 left-0 w-3/5 rotate-[-3deg] rounded-xl bg-white p-3 shadow-lg ring-1 ring-black/6 transition-transform duration-500 group-hover:rotate-0">
									<div class="flex items-center justify-between">
										<span class="flex size-8 items-center justify-center rounded-lg bg-(--primary)/10 text-(--primary)">
											<FileText class="size-4.5" stroke-width={1.7} />
										</span>
										<span class="rounded-full bg-(--sage)/50 px-2 py-0.5 text-[9px] font-bold tracking-wide text-(--plum-ink)">PDF</span>
									</div>
									<p class="mt-3 text-[11px] font-semibold leading-tight text-(--on-surface)">Ma routine bien-être</p>
									<div class="mt-2 flex items-center gap-1 text-[9px] text-(--outline)">
										<Download class="size-3" /> 8 pages
									</div>
								</div>
							</div>
						)}
						
						{/* Mockup Visioconférence */}
						{c.visual === 'visio' && (
							<div class="relative h-full w-full max-w-72">
								<div class="absolute inset-x-4 top-0 overflow-hidden rounded-2xl bg-white p-2 shadow-lg ring-1 ring-black/6 transition-transform duration-500 group-hover:-translate-y-1">
									<div class="relative h-32 overflow-hidden rounded-xl bg-(--sage)">
										<Image
											src={coachPortrait}
											alt="Cécile lors d'un rendez-vous de coaching en visioconférence"
											class="size-full object-cover object-[50%_24%]"
											width={320}
											height={190}
										/>
										<span class="absolute top-2 left-2 flex items-center gap-1 rounded-full bg-white/90 px-2 py-1 text-[9px] font-semibold text-(--on-surface) shadow-sm">
											<span class="size-1.5 rounded-full bg-emerald-500"></span>
											Cécile
										</span>
										<div class="absolute right-2 bottom-2 flex h-12 w-16 items-center justify-center rounded-lg bg-(--plum-ink) text-xs font-semibold text-white shadow-md ring-1 ring-white/25">
											Toi
										</div>
									</div>
									<div class="flex items-center justify-between px-2 pt-2 pb-1">
										<span class="text-[10px] font-medium text-(--on-surface)">Point hebdomadaire</span>
										<div class="flex gap-1.5">
											<span class="size-2 rounded-full bg-(--sage)"></span>
											<span class="size-2 rounded-full bg-(--primary-container)"></span>
											<span class="size-2 rounded-full bg-red-300"></span>
										</div>
									</div>
								</div>
								<div class="absolute right-0 bottom-0 left-0 mx-auto flex w-[88%] items-center gap-3 rounded-xl bg-(--primary) p-3 text-(--on-primary) shadow-lg transition-transform duration-500 group-hover:translate-y-1">
									<span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-white/12">
										<CalendarDays class="size-4.5" stroke-width={1.7} />
									</span>
									<div class="min-w-0">
										<p class="truncate text-[10px] text-white/70">Prochain rendez-vous</p>
										<p class="text-xs font-semibold">Mardi · 18 h 30</p>
									</div>
									<MessagesSquare class="ml-auto size-4 text-(--sage)" stroke-width={1.7} />
								</div>
							</div>
						)}
						
						{/* Aperçu des bonus audio et express */}
						{c.visual === 'bonus' && (
							<div class="relative h-full w-full max-w-72">
								<div class="absolute inset-x-3 top-1 rounded-2xl bg-white p-4 shadow-lg ring-1 ring-black/6 transition-transform duration-500 group-hover:-translate-y-1">
									<div class="flex items-center gap-3">
										<span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-(--sage)/45 text-(--primary)">
											<HeartPulse class="size-5" stroke-width={1.7} />
										</span>
										<div>
											<p class="text-xs font-semibold text-(--on-surface)">Respiration apaisante</p>
											<p class="mt-0.5 flex items-center gap-1 text-[10px] text-(--outline)">
												<Clock3 class="size-3" /> 5 minutes
											</p>
										</div>
									</div>
									<div class="mt-4 flex items-center gap-3">
										<span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-(--primary) text-white">
											<Play class="ml-0.5 size-4" fill="currentColor" />
										</span>
										<div class="flex h-8 flex-1 items-center justify-between gap-0.5">
											{[10, 18, 13, 24, 17, 28, 20, 12, 22, 15, 26, 11].map((height) => (
												<span class="w-1 rounded-full bg-(--primary-container)/65" style={`height:${height}px`}></span>
											))}
										</div>
									</div>
								</div>
								<div class="absolute right-0 bottom-1 left-6 rounded-xl bg-(--plum-ink) p-3 text-white shadow-lg transition-transform duration-500 group-hover:translate-x-1">
									<div class="flex items-center justify-between">
										<div>
											<p class="text-[9px] font-semibold tracking-[0.16em] text-(--sage) uppercase">Nouveau chaque mois</p>
											<p class="mt-1 text-xs font-semibold">Ta vidéo bonus</p>
										</div>
										<span class="flex size-9 items-center justify-center rounded-full bg-white/12">
											<Play class="ml-0.5 size-4" fill="currentColor" />
										</span>
									</div>
								</div>
								<span class="absolute bottom-14 left-0 flex size-9 items-center justify-center rounded-xl bg-[#1DB954] text-white shadow-md" aria-label="Playlists Spotify">
									<Music2 class="size-4.5" stroke-width={2} />
								</span>
								<span class="absolute right-1 top-0 flex size-9 items-center justify-center rounded-xl bg-(--primary-fixed) text-(--plum-ink) shadow-md" aria-label="Cadeau surprise">
									<Gift class="size-4.5" stroke-width={1.8} />
								</span>
							</div>
						)}
					</div>

					<!-- Contenu de la carte -->
					<div class="flex flex-col p-6 sm:p-8">
						<div class="mb-4 flex items-center gap-3">
							<c.icon class="size-6 text-(--primary)" stroke-width={1.75} />
							<h3 class="text-xl font-medium text-(--primary)">{c.title}</h3>
						</div>
						<ul class="space-y-3.5 text-(--on-surface-variant)">
							{c.items.map((it) => (
								<li class="flex items-start gap-3">
									{it.includes('cadeau surprise') ? (
										<span class="flex size-5 shrink-0 items-center justify-center text-base leading-none" aria-hidden="true">
											🎁
										</span>
									) : (
										<Check class="mt-0.5 size-4.5 shrink-0 text-(--primary-container)" aria-hidden="true" stroke-width={2.5} />
									)}
									<span class="text-sm leading-relaxed">{it}</span>
								</li>
							))}
						</ul>
					</div>
				</div>
			))}
		</div>

		<div class="mx-auto mt-16 max-w-fit rounded-full bg-(--surface) px-6 py-3 shadow-sm ring-1 ring-black/5">
			<p class="text-center text-sm font-medium text-(--primary) sm:text-base">
				Durée : <span class="text-(--primary-container)">programme de 4 mois</span> — à ton rythme
			</p>
		</div>
	</div>
</section>
