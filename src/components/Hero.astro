---
import { Image } from 'astro:assets';
import TunnelCtaLink from './TunnelCtaLink.astro';
import heroImageWebp from '../assets/femme-yoga.webp';

const reveal =
	'opacity-0 translate-y-4 transition duration-700 ease-out will-change-transform will-change-opacity motion-reduce:transition-none data-[revealed=true]:opacity-100 data-[revealed=true]:translate-y-0';
---

<section
	class={`relative flex min-h-[90vh] items-center overflow-hidden px-4 py-20 sm:px-10 lg:px-10 ${reveal}`}
	data-reveal
	data-revealed="false"
	aria-labelledby="hero-title"
>
	<div
		class="pointer-events-none absolute top-1/2 -right-64 h-[600px] w-[600px] rounded-full bg-(--primary-fixed-dim)/10 blur-[120px]"
		aria-hidden="true"
	/>

	<div class="relative z-10 mx-auto grid w-full max-w-container grid-cols-1 items-center gap-12 md:grid-cols-2">
		<div class="space-y-8">
			<p class="text-sm font-semibold tracking-[0.2em] text-(--primary-container) uppercase">
				RE-FLOW par Cécile — coach sportive certifiée APA
			</p>
			<h1
				id="hero-title"
				class="text-4xl leading-tight text-(--primary) sm:text-5xl lg:text-[3rem] lg:leading-[1.15]"
			>
				Programme d'Activité Physique Adaptée pour femmes touchées par une maladie chronique
			</h1>
			<p class="max-w-xl text-lg leading-relaxed text-(--secondary)">
				Le programme de reconnexion corporelle à distance avec Cécile, coach sportive diplômée d’État
				et certifiée APA, avec des séances en visio et des ressources à suivre chez toi, partout en France.
			</p>
			<div class="flex flex-col items-start gap-4 sm:flex-row sm:flex-wrap sm:items-center">
				<TunnelCtaLink
					campaign="hero"
					class="inline-flex items-center justify-center rounded-full bg-(--primary) px-8 py-4 text-base font-medium text-(--on-primary) soft-glow transition hover:bg-(--primary-container)"
				>
					Immersion gratuite (4 jours)
				</TunnelCtaLink>
				<a
					href="#programme"
					class="inline-flex items-center justify-center rounded-full border-2 border-(--primary) bg-(--surface-container-lowest) px-8 py-4 text-base font-medium text-(--primary) soft-glow transition hover:bg-(--surface-container)"
				>
					Découvrir le programme
				</a>
			</div>
			<p class="text-sm leading-relaxed text-(--secondary)">
				Nouvelle ici ? Commence par{' '}
				<a
					href="/blog/coach-apa/"
					class="font-semibold text-(--primary) underline underline-offset-4 transition hover:text-(--primary-container)"
				>
					comprendre le rôle d’un coach APA
				</a>
				, puis découvre{' '}
				<a
					href="/a-propos/"
					class="font-semibold text-(--primary) underline underline-offset-4 transition hover:text-(--primary-container)"
				>
					le parcours de Cécile
				</a>
				{' '}et le guide sur les{' '}
				<a
					href="/activites-physiques-adaptees/"
					class="font-semibold text-(--primary) underline underline-offset-4 transition hover:text-(--primary-container)"
				>
					Activité Physique Adaptée (APA)
				</a>
				.
			</p>
		</div>

		<div class="group relative">
			<div
				class="pointer-events-none absolute -inset-4 rounded-4xl bg-(--primary-container)/10 blur-2xl transition group-hover:blur-3xl"
				aria-hidden="true"
			/>
			<Image
				src={heroImageWebp}
				alt="Femme en méditation, assise en tailleur."
				fetchpriority="high"
				loading="eager"
				decoding="async"
				class="relative h-auto w-full rounded-4xl object-contain"
			/>
		</div>
	</div>
</section>
