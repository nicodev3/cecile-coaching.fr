---
import { Image } from 'astro:assets';
import {
	QUIZ_HERO_SECONDARY_CTA_LABEL,
	TUNNEL_IMMERSION_CTA_LABEL,
} from '../consts';
import QuizCtaLink from './QuizCtaLink.astro';
import TunnelCtaLink from './TunnelCtaLink.astro';
import heroImage from '../assets/apa-re-flow.webp';

const reveal =
	'opacity-0 translate-y-4 transition duration-700 ease-out will-change-transform will-change-opacity motion-reduce:transition-none data-[revealed=true]:opacity-100 data-[revealed=true]:translate-y-0';
---

<section
	class={`relative flex overflow-hidden px-4 pt-8 pb-12 sm:px-10 md:min-h-[90vh] md:items-center md:py-20 lg:px-10 ${reveal}`}
	data-reveal
	data-revealed="false"
	aria-labelledby="hero-title"
>
	<div
		class="pointer-events-none absolute top-1/2 -right-64 size-150 rounded-full bg-(--primary-fixed-dim)/10 blur-[120px]"
		aria-hidden="true"
	/>

	<div class="relative z-10 mx-auto grid w-full max-w-container grid-cols-1 items-center gap-8 md:grid-cols-2 md:gap-12">
		<div class="space-y-8">
			<h1
				id="hero-title"
				class="text-4xl leading-tight text-(--primary) sm:text-5xl lg:leading-[1.15] text-balance"
			>
				Programme d’Activité Physique Adaptée pour les femmes touchées par une maladie chronique
			</h1>
			<p class="max-w-xl text-lg leading-relaxed text-(--secondary)">
				<strong class="font-semibold text-(--on-surface-body)">RE-FLOW</strong> avec Cécile Cichosz, coach
				sportive diplômée d’État et certifiée APA : reconnexion corporelle en ligne, séances en visio et
				ressources à suivre de chez toi, partout en France.
			</p>
			<div class="flex flex-col items-start gap-3">
				<div class="flex flex-col items-start gap-4 sm:flex-row sm:flex-wrap sm:items-center">
					<TunnelCtaLink
						campaign="hero"
						class="inline-flex items-center justify-center rounded-full bg-(--primary) px-8 py-4 text-base font-medium text-(--on-primary) soft-glow transition hover:bg-(--primary-container)"
					>
						{TUNNEL_IMMERSION_CTA_LABEL}
					</TunnelCtaLink>
					<QuizCtaLink
						campaign="hero"
						class="inline-flex items-center justify-center rounded-full border-2 border-(--primary)/40 bg-(--surface-container-lowest) px-8 py-4 text-base font-medium text-(--primary) transition hover:bg-(--surface-container)"
						aria-label={`${QUIZ_HERO_SECONDARY_CTA_LABEL} — questionnaire sur ce site`}
					>
						{QUIZ_HERO_SECONDARY_CTA_LABEL}
					</QuizCtaLink>
				</div>
				<p class="max-w-xl text-sm text-(--secondary)">
					L’immersion est gratuite et sans engagement. Tu accèdes à l’espace en ligne dans un nouvel onglet.
				</p>
			</div>
			<details class="group max-w-xl text-sm text-(--secondary)">
				<summary
					class="cursor-pointer list-none rounded-sm font-medium text-(--primary) underline-offset-4 transition hover:text-(--on-surface-accent) hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--primary) [&::-webkit-details-marker]:hidden"
				>
					Nouvelle ici ? Où lire avant de te lancer
				</summary>
				<p class="mt-3 leading-relaxed">
					Commence par le{' '}
					<a
						href="#guide-recommande"
						class="font-semibold text-(--primary) underline underline-offset-4 transition hover:text-(--on-surface-accent)"
					>
						guide coach APA
					</a>
					{' '}sur cette page. Ensuite, explore le{' '}
					<a
						href="/coach-apa-en-ligne/"
						class="font-semibold text-(--primary) underline underline-offset-4 transition hover:text-(--on-surface-accent)"
					>
						programme en visio
					</a>
					, le{' '}
					<a
						href="/activites-physiques-adaptees/"
						class="font-semibold text-(--primary) underline underline-offset-4 transition hover:text-(--on-surface-accent)"
					>
						guide APA
					</a>
					{' '}et{' '}
					<a
						href="/a-propos/"
						class="font-semibold text-(--primary) underline underline-offset-4 transition hover:text-(--on-surface-accent)"
					>
						le parcours de Cécile
					</a>
					.
				</p>
			</details>
		</div>

		<div class="group relative flex justify-center md:justify-end">
			<div
				class="pointer-events-none absolute -inset-4 rounded-4xl bg-(--primary-container)/10 blur-2xl transition group-hover:blur-3xl"
				aria-hidden="true"
			/>
			<Image
				src={heroImage}
				alt="Femme en tenue de sport, les bras levés dans un étirement."
				fetchpriority="high"
				loading="eager"
				decoding="async"
				class="relative mx-auto max-h-[min(22rem,48vh)] w-auto max-w-[85%] rounded-4xl object-contain sm:max-h-80 md:mx-0 md:max-h-[70vh] md:max-w-full"
			/>
		</div>
	</div>
</section>
