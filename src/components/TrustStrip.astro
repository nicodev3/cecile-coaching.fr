---
import { Heart, ShieldCheck, TrendingUp } from '@lucide/astro';

const items = [
	{
		title: 'Certifiée APA',
		desc: 'Activité Physique Adaptée pour les femmes avec maladie chronique ou fatigue — sans culture performance.',
		icon: ShieldCheck,
	},
	{
		title: '4 mois · 48 séances',
		desc: 'Progression douce, 3 séances guidées par semaine et un point individuel hebdomadaire en visio.',
		icon: TrendingUp,
	},
	{
		title: '100 % en ligne',
		desc: 'Depuis chez toi, partout en France — immersion gratuite 4 jours pour tester avant de t’engager.',
		icon: Heart,
	},
];

const reveal =
	'opacity-0 translate-y-4 transition duration-700 ease-out will-change-transform will-change-opacity motion-reduce:transition-none data-[revealed=true]:opacity-100 data-[revealed=true]:translate-y-0';
---

<section
	class={`bg-(--surface-container-low) py-20 sm:px-10 ${reveal}`}
	data-reveal
	data-revealed="false"
	aria-label="Éléments de confiance"
>
	<div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
		<ul class="grid gap-10 md:grid-cols-3 md:gap-8">
			{items.map((it) => (
				<li class="flex flex-col gap-3 text-center md:text-left">
					<div class="flex flex-col items-center gap-3 md:flex-row md:items-start">
						<span
							class="flex size-11 shrink-0 items-center justify-center rounded-full bg-(--primary-fixed-dim)/35 text-(--primary)"
							aria-hidden="true"
						>
							<it.icon class="size-5" stroke-width={1.5} />
						</span>
						<p class="text-xl font-medium text-(--primary) sm:text-2xl">{it.title}</p>
					</div>
					<p class="text-base leading-relaxed text-(--secondary)">{it.desc}</p>
				</li>
			))}
		</ul>
	</div>
</section>
