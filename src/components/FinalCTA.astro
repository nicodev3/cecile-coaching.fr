---
import { TUNNEL_IMMERSION_CTA_LABEL } from '../consts';
import TunnelCtaLink from './TunnelCtaLink.astro';
import WhatsAppCtaLink from './WhatsAppCtaLink.astro';

const reveal =
	'opacity-0 translate-y-4 transition duration-700 ease-out will-change-transform will-change-opacity motion-reduce:transition-none data-[revealed=true]:opacity-100 data-[revealed=true]:translate-y-0';
---

<section
	id="cta"
	class={`relative overflow-hidden py-20 sm:px-10 ${reveal}`}
	data-reveal
	data-revealed="false"
	aria-labelledby="cta-title"
>
	<div
		class="pointer-events-none absolute -bottom-40 -left-40 size-125 rounded-full bg-(--primary-fixed-dim)/20 blur-[100px]"
		aria-hidden="true"
	/>

	<div class="relative z-10 mx-auto max-w-container px-4 sm:px-6 lg:px-8">
		<div class="rounded-12 bg-(--primary) px-8 py-12 text-center text-(--on-primary) sm:px-16 sm:py-20 md:px-24">
			<h2 id="cta-title" class="text-3xl sm:text-5xl">
				Prête à reconnecter avec ton corps ?
			</h2>
			<p class="mx-auto mt-6 max-w-2xl text-lg text-(--on-primary-container)">
				Commence par tester le programme pendant 4 jours, gratuitement et sans engagement. Si tu préfères en
				parler avant, réserve un échange ou pose une question rapide sur WhatsApp.
			</p>
			<div class="mt-10 flex flex-col items-center justify-center gap-4">
				<TunnelCtaLink
					campaign="final-cta"
					class="inline-flex w-full max-w-md items-center justify-center rounded-full bg-(--surface) px-10 py-5 text-lg font-bold text-(--primary) transition hover:bg-(--primary-fixed) sm:w-auto"
				>
					{TUNNEL_IMMERSION_CTA_LABEL}
				</TunnelCtaLink>
				<div class="flex w-full max-w-lg flex-col gap-3 sm:flex-row sm:justify-center">
					<a
						href="#contact"
						class="inline-flex flex-1 items-center justify-center rounded-full border border-(--on-primary)/35 px-8 py-3.5 text-base font-semibold text-(--on-primary) transition hover:bg-(--on-primary)/10"
					>
						Échanger avant de commencer
					</a>
					<WhatsAppCtaLink
						campaign="final-cta"
						showIcon={true}
						class="inline-flex flex-1 items-center justify-center gap-2 rounded-full border border-(--on-primary)/25 px-8 py-3.5 text-base font-medium text-(--on-primary-container) transition hover:bg-(--on-primary)/10"
					>
						Question sur WhatsApp
					</WhatsAppCtaLink>
				</div>
			</div>
		</div>
	</div>
</section>
