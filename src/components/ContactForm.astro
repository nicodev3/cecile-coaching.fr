---
import {
	AlertCircle,
	CheckCircle2,
	Clock3,
	Mail,
	MessageCircle,
	Phone,
	Send,
	ShieldCheck,
} from '@lucide/astro';
import WhatsAppCtaLink from './WhatsAppCtaLink.astro';
import { COACH_EMAIL } from '../consts';

const reveal =
	'opacity-0 translate-y-4 transition duration-700 ease-out will-change-transform will-change-opacity motion-reduce:transition-none data-[revealed=true]:opacity-100 data-[revealed=true]:translate-y-0';
---

<section
	id="contact"
	class={`bg-(--surface-container-low) py-20 sm:px-10 ${reveal}`}
	data-reveal
	data-revealed="false"
	aria-labelledby="contact-title"
>
	<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<p class="text-sm font-semibold tracking-[0.18em] text-(--primary-container) uppercase">Parlons de ta situation</p>
			<h2 id="contact-title" class="text-3xl text-(--primary) sm:text-5xl">Me contacter</h2>
			<p class="mt-4 text-lg leading-relaxed text-(--secondary)">
				Une question sur RE-FLOW ou envie de vérifier si l’accompagnement te correspond ? Écris-moi simplement.
			</p>
		</div>

		<div class="mt-12 grid items-start gap-8 lg:grid-cols-[0.72fr_1.28fr]">
			<aside class="space-y-4" aria-label="Autres moyens de contact">
				<WhatsAppCtaLink
					campaign="contact"
					class="group flex items-start gap-4 rounded-2xl bg-(--whatsapp-surface) p-5 text-left ring-1 ring-(--whatsapp)/15 transition hover:bg-white hover:ring-(--whatsapp)/30 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--whatsapp)"
					aria-label="Poser une question rapide sur WhatsApp"
				>
					<span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-white text-(--whatsapp)">
						<MessageCircle class="size-5.5" aria-hidden="true" stroke-width={2} />
					</span>
					<span>
						<span class="block font-semibold text-(--on-surface)">Question rapide sur WhatsApp</span>
						<span class="mt-1 block text-sm leading-relaxed text-(--on-surface-variant)">
							Le canal le plus simple pour une première question.
						</span>
					</span>
				</WhatsAppCtaLink>

				<div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/5">
					<div class="flex items-start gap-4">
						<span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-(--primary)/8 text-(--primary)">
							<Phone class="size-5" aria-hidden="true" stroke-width={1.8} />
						</span>
						<span>
							<span class="block text-sm text-(--secondary)">Tu préfères appeler ?</span>
							<a
								id="phone-link"
								href="#"
								class="mt-1 block font-semibold text-(--primary) hover:underline"
								aria-label="Téléphone"
							>
								<span id="phone-display">Chargement…</span>
							</a>
						</span>
					</div>
					<div class="mt-4 flex items-center gap-2 border-t border-black/5 pt-4 text-sm text-(--secondary)">
						<Clock3 class="size-4 shrink-0 text-(--primary)" aria-hidden="true" />
						Réponse sous 24 à 48 h ouvrées
					</div>
				</div>

				<div class="rounded-2xl bg-(--primary) p-5 text-(--on-primary)">
					<ShieldCheck class="size-6 text-(--sage)" stroke-width={1.8} aria-hidden="true" />
					<p class="mt-3 font-semibold">Échange confidentiel</p>
					<p class="mt-1 text-sm leading-relaxed text-white/75">
						Ton message est transmis directement à Cécile et n’est jamais utilisé à des fins publicitaires.
					</p>
				</div>
			</aside>

			<form
				name="contact"
				method="POST"
				action="/api/contact"
				class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-black/5 sm:p-8 lg:p-10"
			>
				<div class="mb-7">
					<div class="flex items-center gap-3">
						<span class="flex size-10 items-center justify-center rounded-xl bg-(--primary-fixed) text-(--primary)">
							<Mail class="size-5" stroke-width={1.8} aria-hidden="true" />
						</span>
						<div>
							<h3 class="text-xl font-semibold text-(--primary)">Écris-moi ton message</h3>
							<p class="mt-0.5 text-sm text-(--secondary)">Les champs marqués * sont obligatoires.</p>
						</div>
					</div>
				</div>

				<div class="sr-only" aria-hidden="true">
					<label for="contact-gotcha">Ne pas remplir</label>
					<input type="text" id="contact-gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
				</div>

				<div class="grid gap-5 sm:grid-cols-2">
					<div>
						<label for="name" class="text-sm font-semibold text-(--on-surface)">
							Nom <span aria-hidden="true" class="text-(--primary)">*</span>
						</label>
						<input
							type="text"
							id="name"
							name="name"
							required
							maxlength="120"
							autocomplete="name"
							class="mt-2 w-full rounded-xl border border-black/8 bg-(--surface-container-low) px-4 py-3.5 text-(--on-surface) transition placeholder:text-(--outline) focus:border-(--primary)/35 focus:ring-3 focus:ring-(--primary)/12 focus:outline-none"
							placeholder="Ton nom"
						/>
					</div>
					<div>
						<label for="email" class="text-sm font-semibold text-(--on-surface)">
							Email <span aria-hidden="true" class="text-(--primary)">*</span>
						</label>
						<input
							type="email"
							id="email"
							name="email"
							required
							maxlength="254"
							autocomplete="email"
							inputmode="email"
							class="mt-2 w-full rounded-xl border border-black/8 bg-(--surface-container-low) px-4 py-3.5 text-(--on-surface) transition placeholder:text-(--outline) focus:border-(--primary)/35 focus:ring-3 focus:ring-(--primary)/12 focus:outline-none"
							placeholder="ton@email.com"
						/>
					</div>
				</div>

				<div class="mt-5">
					<label for="phone" class="text-sm font-semibold text-(--on-surface)">
						Téléphone <span class="font-normal text-(--secondary)">(optionnel)</span>
					</label>
					<input
						type="tel"
						id="phone"
						name="phone"
						maxlength="40"
						autocomplete="tel"
						inputmode="tel"
						class="mt-2 w-full rounded-xl border border-black/8 bg-(--surface-container-low) px-4 py-3.5 text-(--on-surface) transition placeholder:text-(--outline) focus:border-(--primary)/35 focus:ring-3 focus:ring-(--primary)/12 focus:outline-none"
						placeholder="06 12 34 56 78"
					/>
				</div>

				<div class="mt-5">
					<label for="message" class="text-sm font-semibold text-(--on-surface)">
						Message <span aria-hidden="true" class="text-(--primary)">*</span>
					</label>
					<p id="message-help" class="mt-1 text-xs text-(--secondary)">
						Tu peux indiquer tes besoins, tes contraintes ou simplement poser ta question.
					</p>
					<textarea
						id="message"
						name="message"
						required
						maxlength="5000"
						rows="6"
						aria-describedby="message-help"
						class="mt-2 w-full resize-y rounded-xl border border-black/8 bg-(--surface-container-low) px-4 py-3.5 text-(--on-surface) transition placeholder:text-(--outline) focus:border-(--primary)/35 focus:ring-3 focus:ring-(--primary)/12 focus:outline-none"
						placeholder="Bonjour Cécile, je souhaiterais…"
					></textarea>
				</div>

				<div
					id="form-success"
					class="mt-5 hidden rounded-xl bg-emerald-50 p-4 text-emerald-900 ring-1 ring-emerald-200"
					role="status"
					aria-live="polite"
					tabindex="-1"
				>
					<div class="flex gap-3">
						<CheckCircle2 class="mt-0.5 size-5 shrink-0 text-emerald-700" aria-hidden="true" />
						<div>
							<p class="font-semibold">Ton message a bien été envoyé.</p>
							<p class="mt-1 text-sm">Merci ! Je te répondrai sous 24 à 48 h ouvrées.</p>
						</div>
					</div>
				</div>

				<div
					id="form-error"
					class="mt-5 hidden rounded-xl bg-red-50 p-4 text-red-900 ring-1 ring-red-200"
					role="alert"
					tabindex="-1"
				>
					<div class="flex gap-3">
						<AlertCircle class="mt-0.5 size-5 shrink-0 text-red-700" aria-hidden="true" />
						<div>
							<p class="font-semibold">Le message n’a pas pu être envoyé.</p>
							<p class="mt-1 text-sm">
								Réessaie dans un instant ou écris directement à{' '}
								<a class="font-semibold underline" href={`mailto:${COACH_EMAIL}`}>{COACH_EMAIL}</a>.
							</p>
						</div>
					</div>
				</div>

				<button
					type="submit"
					class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full bg-(--primary) px-6 py-4 text-base font-semibold text-(--on-primary) shadow-sm transition hover:bg-(--primary-container) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--primary) disabled:cursor-wait disabled:opacity-70"
				>
					<Send class="size-4.5" aria-hidden="true" stroke-width={2} />
					<span data-submit-label>Envoyer mon message</span>
				</button>

				<p class="mt-4 flex items-start justify-center gap-2 text-center text-xs leading-relaxed text-(--secondary)">
					<ShieldCheck class="mt-0.5 size-3.5 shrink-0" aria-hidden="true" />
					<span>
						En envoyant ce formulaire, tu acceptes que Cécile utilise ces informations pour te répondre.
						<a href="/politique-de-confidentialite/" class="font-semibold text-(--primary) hover:underline">
							Politique de confidentialité
						</a>
					</span>
				</p>
			</form>
		</div>
	</div>
</section>

<script is:inline>
	(function () {
		const a = '0' + '6';
		const b = '8' + '6';
		const c = '4' + '1';
		const d = '5' + '7';
		const e = '0' + '1';
		const phoneNumber = a + b + c + d + e;
		const phoneDisplay = phoneNumber.replace(/(\d{2})(\d{2})(\d{2})(\d{2})(\d{2})/, '$1 $2 $3 $4 $5');

		const phoneLink = document.getElementById('phone-link');
		const phoneDisplayEl = document.getElementById('phone-display');

		if (phoneLink && phoneDisplayEl) {
			phoneLink.href = 'tel:+33' + phoneNumber.substring(1);
			phoneDisplayEl.textContent = phoneDisplay;
		}
	})();
</script>

<script is:inline>
	const form = document.querySelector('form[name="contact"]');
	const formSuccess = document.getElementById('form-success');
	const formError = document.getElementById('form-error');
	const params = new URLSearchParams(window.location.search);
	const sent = params.get('sent');

	if (sent === '1' || sent === '0') {
		const status = sent === '1' ? formSuccess : formError;
		status?.classList.remove('hidden');
		requestAnimationFrame(() => {
			status?.scrollIntoView({ behavior: 'smooth', block: 'center' });
			status?.focus({ preventScroll: true });
		});

		const cleanUrl = new URL(window.location.href);
		cleanUrl.searchParams.delete('sent');
		window.history.replaceState({}, '', cleanUrl);
	}

	if (form instanceof HTMLFormElement) {
		form.addEventListener('submit', () => {
			const submitButton = form.querySelector('button[type="submit"]');
			const submitLabel = form.querySelector('[data-submit-label]');

			formSuccess?.classList.add('hidden');
			formError?.classList.add('hidden');

			if (submitButton instanceof HTMLButtonElement) {
				submitButton.disabled = true;
				submitButton.setAttribute('aria-busy', 'true');
			}
			if (submitLabel) submitLabel.textContent = 'Envoi en cours…';
		});
	}
</script>
