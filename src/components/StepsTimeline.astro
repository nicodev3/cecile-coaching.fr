---
const steps = [
	{
		title: 'Reconnexion & sécurité',
		desc: 'Remettre le corps en mouvement en douceur, installer des pratiques sécuritaires.',
		benefit: 'Tu prends du temps pour toi et tu réinvestis ton corps.',
		badgeClass: 'bg-(--primary) text-(--on-primary)',
	},
	{
		title: 'Force & progressivité',
		desc: 'Construire force, stabilité, équilibre et endurance de manière progressive en respectant la fatigue.',
		benefit: 'Tu te sens plus forte dans les mouvements du quotidien.',
		badgeClass: 'bg-(--primary-fixed-dim) text-(--on-primary-fixed-variant)',
	},
	{
		title: 'Vitalité & énergie',
		desc: "C'est le moment d'augmenter l'intensité, tout en restant à l'écoute de son corps.",
		benefit: "Tu as davantage d'énergie, tu te sens plus endurante.",
		badgeClass: 'bg-(--primary-container) text-(--on-primary)',
	},
	{
		title: 'Confiance & autonomie',
		desc: 'Stabiliser les progrès et installer une routine durable, reprendre confiance dans ses capacités physiques. .',
		benefit: 'Tu es devenue autonome dans ta pratique.',
		badgeClass: 'bg-(--secondary) text-(--on-secondary)',
	},
];

const reveal =
	'opacity-0 translate-y-4 transition duration-700 ease-out will-change-transform will-change-opacity motion-reduce:transition-none data-[revealed=true]:opacity-100 data-[revealed=true]:translate-y-0';
---

<section
	id="programme"
	class={`bg-(--surface-bright) py-20 sm:px-10 ${reveal}`}
	data-reveal
	data-revealed="false"
	aria-labelledby="steps-title"
>
	<div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
		<div class="mb-20 text-center">
			<h2 id="steps-title" class="text-3xl text-(--primary) sm:text-5xl">
				Les 4 étapes de transformation
			</h2>
			<p class="mt-4 text-(--secondary)">Une progression en ligne claire, douce et rassurante.</p>
		</div>

		<ol class="relative mx-auto max-w-4xl space-y-8 sm:space-y-12">
			<div
				class="absolute top-10 bottom-10 left-[27px] w-[2px] bg-(--outline-variant) sm:left-1/2 sm:-translate-x-1/2"
				aria-hidden="true"
			/>
			{
				steps.map((s, idx) => (
					<li class="relative flex flex-col gap-6 sm:flex-row sm:items-stretch">
						<!-- Colonne de gauche (vide en alternance ou contenu desc) -->
						<div class={`flex-1 text-left sm:text-right sm:pr-12 ${idx % 2 === 1 ? 'sm:order-1 sm:hidden' : ''}`}>
							<div class="hidden sm:block">
								<h3 class="text-2xl font-medium text-(--primary)">{s.title}</h3>
								<p class="mt-3 leading-relaxed text-(--on-surface-variant)">{s.desc}</p>
							</div>
						</div>
						
						<!-- Badge central -->
						<div
							class:list={[
								'z-10 absolute left-0 top-0 flex size-14 items-center justify-center rounded-full text-lg font-semibold shadow-sm sm:relative sm:-mt-1 sm:shrink-0',
								s.badgeClass,
								'ring-4 ring-(--surface-bright)'
							]}
							aria-hidden="true"
						>
							{idx + 1}
						</div>
						
						<!-- Colonne de droite -->
						<div class={`flex-1 pl-20 sm:pl-12 ${idx % 2 === 1 ? 'sm:order-3' : ''}`}>
							<!-- Contenu desc en mobile pour le odd alignement, sinon sur desktop c'est dans la col opposée -->
							<div class={idx % 2 === 0 ? 'sm:hidden' : ''}>
								<h3 class="text-2xl font-medium text-(--primary)">{s.title}</h3>
								<p class="mt-2 text-sm leading-relaxed text-(--on-surface-variant) sm:text-base sm:mt-3">{s.desc}</p>
							</div>
							
							<!-- Bénéfice (toujours visible ici en mobile) -->
							<div class="mt-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/5 sm:mt-0">
								<p class="text-sm font-medium text-(--primary) italic">"{s.benefit}"</p>
							</div>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
