---
import { tunnelCtaEvent } from '../config/analyticsEvents';
import { tunnelEntryUrl } from '../utils/tunnelUrl';

interface Props {
	/** Identifiant UTM `utm_campaign` + suffixe événement Umami */
	campaign: string;
	/** Chemin côté tunnel. Par défaut, l’entrée de conversion du tunnel. */
	path?: string;
	class?: string;
	/** Annonce l’ouverture dans un nouvel onglet (défaut : oui). */
	announceNewTab?: boolean;
	'aria-label'?: string;
}

const {
	campaign,
	path,
	class: className,
	announceNewTab = true,
	'aria-label': ariaLabel,
} = Astro.props;
const href = tunnelEntryUrl(campaign, path);
const umamiEvent = tunnelCtaEvent(campaign);
---

<a
	href={href}
	class={className}
	target="_blank"
	rel="noopener noreferrer"
	aria-label={ariaLabel}
	data-umami-event={umamiEvent}
>
	<slot />
	{
		announceNewTab && (
			<span class="sr-only"> — ouvre l’espace immersion dans un nouvel onglet</span>
		)
	}
</a>
