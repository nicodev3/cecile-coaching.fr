---
import { quizCtaEvent } from '../config/analyticsEvents';
import { QUIZ_PATH, tunnelEntryUrl } from '../utils/tunnelUrl';

interface Props {
	/** Identifiant de placement : `utm_campaign` + événement Umami. */
	campaign: string;
	class?: string;
	'aria-label'?: string;
}

const { campaign, class: className, 'aria-label': ariaLabel } = Astro.props;
---

<a
	href={tunnelEntryUrl(campaign, QUIZ_PATH)}
	class={className}
	data-umami-event={quizCtaEvent(campaign)}
	aria-label={ariaLabel}
>
	<slot />
</a>
