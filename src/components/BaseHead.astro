---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { Font } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/cecile-coach-apa.webp';
import {
	AHREFS_ANALYTICS_KEY,
	META_PIXEL_ID,
	UMAMI_ALLOWED_DOMAINS,
	UMAMI_URL,
	UMAMI_WEBSITE_ID,
} from '../config/analytics';
import {
	COACH_FAMILY_NAME,
	COACH_FIRST_NAME,
	COACH_NAME,
	COACH_SIRET,
	INDEXNOW_KEY,
	SITE_INSTAGRAM,
	SITE_TITLE,
	SITE_WHATSAPP,
} from '../consts';

type StructuredData = Record<string, unknown>;

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	structuredData?: StructuredData | StructuredData[];
	ogType?: 'website' | 'article';
	noindex?: boolean;
	nofollow?: boolean;
	includeCanonical?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = FallbackImage,
	structuredData,
	ogType = 'website',
	noindex = false,
	nofollow = false,
	includeCanonical = true,
} = Astro.props;
const siteUrl = Astro.site?.toString() ?? `${Astro.url.origin}/`;
const siteUrlNormalized = siteUrl.endsWith('/') ? siteUrl.slice(0, -1) : siteUrl;

const logoUrl = new URL('/favicon.svg', siteUrlNormalized).toString();

const coachingStructuredData: StructuredData = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	'@id': `${siteUrlNormalized}/#coaching-service`,
	name: 'RE-FLOW par Cécile Cichosz',
	alternateName: [
		'RE-FLOW',
		'RE-FLOW par Cécile',
		'Coaching sportif adapté en ligne',
	],
	legalName: COACH_NAME,
	description:
		'Programme de reconnexion corporelle en ligne pour femmes touchées par une maladie chronique, avec coaching sportif adapté et certification APA à distance.',
	url: siteUrlNormalized,
	logo: logoUrl,
	image: logoUrl,
	areaServed: {
		'@type': 'Country',
		name: 'France',
	},
	founder: {
		'@type': 'Person',
		'@id': `${siteUrlNormalized}/a-propos/#cecile`,
		name: COACH_NAME,
		givenName: COACH_FIRST_NAME,
		familyName: COACH_FAMILY_NAME,
		url: `${siteUrlNormalized}/a-propos/`,
		jobTitle: 'Coach sportive diplômée d’État - BPJEPS Activités de la forme, certifiée APA',
	},
	identifier: {
		'@type': 'PropertyValue',
		name: 'SIRET',
		value: COACH_SIRET,
	},
	sameAs: [SITE_INSTAGRAM, SITE_WHATSAPP],
	knowsAbout: [
		'Activité Physique Adaptée',
		'Certification APA',
		'BPJEPS Activités de la forme',
		'Maladie chronique',
		'Fatigue chronique',
		'Reconnexion corporelle',
		'Coaching sportif adapté',
	],
};

const webPageStructuredData: StructuredData = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	'@id': `${canonicalURL.href}#webpage`,
	url: canonicalURL.href,
	name: title,
	description,
	inLanguage: 'fr-FR',
	about: { '@id': `${siteUrlNormalized}/#coaching-service` },
};

const extraStructuredData = Array.isArray(structuredData)
	? structuredData
	: structuredData
		? [structuredData]
		: [];
const structuredDataScripts = noindex
	? []
	: [coachingStructuredData, webPageStructuredData, ...extraStructuredData];
const umamiEnabled = import.meta.env.PROD && UMAMI_WEBSITE_ID && UMAMI_URL;
const metaPixelEnabled = import.meta.env.PROD && META_PIXEL_ID;
---

<Font cssVariable="--font-body" />
<Font cssVariable="--font-title" />

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="preconnect" href="https://www.youtube.com" />
<link rel="preconnect" href="https://i.ytimg.com" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="indexnow" content={INDEXNOW_KEY} />

<!-- Canonical URL -->
{includeCanonical && <link rel="canonical" href={canonicalURL} />}
{noindex && <meta name="robots" content={nofollow ? 'noindex, nofollow' : 'noindex, follow'} />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:locale" content="fr_FR" />
<meta property="og:site_name" content="RE-FLOW par Cécile Cichosz" />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.site)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image.src, Astro.site)} />

{
	umamiEnabled && (
			<script
				defer
				src={`${UMAMI_URL}/script.js`}
				data-website-id={UMAMI_WEBSITE_ID}
				data-domains={UMAMI_ALLOWED_DOMAINS}
			></script>
		)
}

{
	(AHREFS_ANALYTICS_KEY || metaPixelEnabled) && (
		<script
			is:inline
			define:vars={{ AHREFS_ANALYTICS_KEY, META_PIXEL_ID, metaPixelEnabled }}
		>
			const loadDeferredTrackers = () => {
				if (window.__reflowTrackersLoaded) return;
				window.__reflowTrackersLoaded = true;

				if (AHREFS_ANALYTICS_KEY) {
					const ahrefs = document.createElement('script');
					ahrefs.src = 'https://analytics.ahrefs.com/analytics.js';
					ahrefs.async = true;
					ahrefs.dataset.key = AHREFS_ANALYTICS_KEY;
					document.head.appendChild(ahrefs);
				}

				if (metaPixelEnabled) {
					!(function (f, b, e, v, n, t, s) {
						if (f.fbq) return;
						n = f.fbq = function () {
							n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
						};
						if (!f._fbq) f._fbq = n;
						n.push = n;
						n.loaded = !0;
						n.version = '2.0';
						n.queue = [];
						t = b.createElement(e);
						t.async = !0;
						t.src = v;
						s = b.getElementsByTagName(e)[0];
						s.parentNode.insertBefore(t, s);
					})(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
					fbq('init', META_PIXEL_ID);
					fbq('track', 'PageView');
				}
			};

			const armDeferredTrackers = () => {
				const events = ['pointerdown', 'keydown', 'scroll', 'touchstart'];
				let fallback = 0;
				const start = () => {
					clearTimeout(fallback);
					events.forEach((eventName) => window.removeEventListener(eventName, start));
					loadDeferredTrackers();
				};
				events.forEach((eventName) =>
					window.addEventListener(eventName, start, { passive: true, once: true }),
				);
				fallback = setTimeout(start, 8000);
			};

			if (document.readyState === 'complete') armDeferredTrackers();
			else window.addEventListener('load', armDeferredTrackers, { once: true });
		</script>
	)
}
{
	metaPixelEnabled && (
		<noscript>
			<img
				height="1"
				width="1"
				style="display:none"
				src={`https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1`}
				alt=""
			/>
		</noscript>
	)
}

{
	structuredDataScripts.map((schema) => (
		<script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
	))
}
