---
import { CalendarDays, Laptop, WalletCards } from '@lucide/astro';
import WhatsAppCtaLink from './WhatsAppCtaLink.astro';

const reveal =
	'opacity-0 translate-y-4 transition duration-700 ease-out will-change-transform will-change-opacity motion-reduce:transition-none data-[revealed=true]:opacity-100 data-[revealed=true]:translate-y-0';
---

<section
	id="tarif"
	class={`bg-(--surface-bright) py-20 sm:px-10 ${reveal}`}
	data-reveal
	data-revealed="false"
	aria-labelledby="pricing-title"
>
	<div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
		<div class="mb-16 text-center">
			<h2 id="pricing-title" class="text-3xl text-(--primary) sm:text-5xl">Durée & modalités</h2>
			<p class="mt-4 text-(--secondary)">
				Un cadre simple et transparent pour avancer sans pression.
			</p>
		</div>

		<div class="mx-auto grid max-w-5xl gap-4 sm:grid-cols-3">
			<div class="rounded-2xl bg-(--surface-container-lowest) p-6 text-center shadow-sm ring-1 ring-black/5">
				<CalendarDays class="mx-auto size-7 text-(--primary)" stroke-width={1.7} aria-hidden="true" />
				<p class="mt-4 text-2xl font-semibold text-(--primary)">4 mois</p>
				<p class="mt-1 text-sm text-(--secondary)">16 semaines de progression</p>
			</div>
			<div class="rounded-2xl bg-(--surface-container-lowest) p-6 text-center shadow-sm ring-1 ring-black/5">
				<Laptop class="mx-auto size-7 text-(--primary)" stroke-width={1.7} aria-hidden="true" />
				<p class="mt-4 text-2xl font-semibold text-(--primary)">100 % en ligne</p>
				<p class="mt-1 text-sm text-(--secondary)">Depuis chez toi, partout en France</p>
			</div>
			<div class="rounded-2xl bg-(--surface-container-lowest) p-6 text-center shadow-sm ring-1 ring-black/5">
				<WalletCards class="mx-auto size-7 text-(--primary)" stroke-width={1.7} aria-hidden="true" />
				<p class="mt-4 text-2xl font-semibold text-(--primary)">Tarif sur demande</p>
				<p class="mt-1 text-sm text-(--secondary)">Modalités de paiement expliquées ensemble</p>
			</div>
		</div>

		<div class="mx-auto mt-10 max-w-2xl rounded-2xl bg-(--sage)/25 p-6 text-center sm:p-8">
			<p class="text-lg font-semibold text-(--primary)">
				Une question avant de te décider ?
			</p>
			<p class="mt-2 text-(--secondary)">
				Échangeons sur ta situation et vérifions ensemble si le programme te correspond.
			</p>
			<div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
				<WhatsAppCtaLink
					campaign="pricing"
					showIcon={true}
					class="whatsapp-btn rounded-full px-8 py-3 text-base font-semibold"
				>
					Demander le tarif
				</WhatsAppCtaLink>
				<a
					class="inline-flex items-center justify-center rounded-full border border-(--primary)/25 px-8 py-3 font-semibold text-(--primary) transition hover:bg-white/70"
					href="#faq"
				>
					Voir la FAQ
				</a>
			</div>
		</div>
	</div>
</section>
