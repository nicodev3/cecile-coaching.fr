---
import { ChevronLeft, ChevronRight, Star, X } from "@lucide/astro";

const testimonials = [
  {
    name: "Anne Sandrine Blanc",
    source: "Avis Google",
    quote:
      "Cécile a développé pour moi un programme parfaitement adapté et personnalisé qui répond absolument à mes attentes. Elle a pris le temps de m’écouter et de rechercher pour moi les exercices les plus pertinents. Le soin qu’elle a mis à la préparation du programme est très important. J’ai à ma disposition plusieurs modules que je peux effectuer séparément ou combinés selon le temps que je peux consacrer et ce que j’ai décidé de travailler. Cécile est venue à la maison me montrer chaque exercice en détail et les vidéos de support sont très bien faites, faciles à utiliser et permettent de réaliser les exercices en suivant chaque mouvement à l’écran. C’est extrêmement bien fait et les différents liens sont super fluides pour ne pas perdre de temps à chercher ce que l’on veut visionner. On peut suivre la séance entière à l’écran si on veut. Le support pdf permet en plus de se repérer à l’avance et faire son choix au coup par coup ou pour la semaine si on veut. J’adore son dynamisme qui donne de l’énergie et sa présence virtuelle avec sa voix qui encourage est vraiment sympa :) Un grand merci à Cécile !",
  },
  {
    name: "Rachel",
    source: "",
    quote:
      "Merci infiniment pour toutes ces séances qui m'ont apporté beaucoup, que ce soit pour un mieux-être physique et moral, une reprise de confiance en moi et bien d'autres choses encore.",
  },
  {
    name: "Aude",
    source: "",
    quote:
      "J'en profite pour te remercier pour cette super année avec toi. Ta bonne humeur communicative, la qualité de tes cours, ta gentillesse et ta bienveillance sont très précieux et je me sens chanceuse d'en bénéficier.",
  },
  {
    name: "Martine",
    source: "Avis Google",
    quote:
      "Grâce à sa motivation et son empathie, je BOUGE ! Entrée avec 1 canne, j'ai remusclé mes jambes et marche sans depuis plusieurs mois.",
  },
  {
    name: "Nadia",
    source: "",
    quote:
      "Je n'ai plus cette pression de « performer ». J'avance à mon rythme, et ça change tout pour ma confiance personnelle.",
  },
  {
    name: "Sophie",
    source: "",
    quote:
      "Le suivi est précieux : je me sens comprise, et je sais quoi faire même les jours où je suis moins en forme.",
  },
  {
    name: "Emmanuel",
    source: "",
    quote:
      "Je souhaite également profiter de ce message pour souligner la grande qualité du travail fourni par Cécile : son application, son attention pour chacun d'entre nous et, plus globalement, sa bienveillance et son professionnalisme que je trouve absolument remarquables.",
  },
  {
    name: "Emmanuel",
    source: "",
    quote:
      "Le groupe compte environ une dizaine de personnes, avec des situations et des niveaux différents. Malgré cela, Cécile parvient toujours à adapter son accompagnement, avec le sourire, un mot juste et une vigilance constante. Même si, je l'avoue, je ne suis pas toujours ravi d'y aller avant le cours, je constate à quel point cette activité m'est bénéfique. C'est suffisamment rare, au regard de certaines expériences passées, pour que je tienne à le souligner.",
  },
];

const reveal =
  "opacity-0 translate-y-4 transition duration-700 ease-out will-change-transform will-change-opacity motion-reduce:transition-none data-[revealed=true]:opacity-100 data-[revealed=true]:translate-y-0";
---

<section
  id="temoignages"
  class={`bg-(--surface-container) px-4 py-20 sm:px-10 lg:px-16 ${reveal}`}
  data-reveal
  data-revealed="false"
  aria-labelledby="testimonials-title"
>
  <div class="mx-auto max-w-container">
    <h2
      id="testimonials-title"
      class="mb-16 px-2 text-center text-3xl text-(--primary) sm:text-5xl"
    >
      Elles ont reconnecté avec leur corps
    </h2>

    <div class="relative" data-testimonials-carousel>
      <div
        class="mx-12 flex snap-x snap-mandatory gap-8 overflow-x-auto scroll-smooth py-4 sm:mx-16 [-ms-overflow-style:none] scrollbar-none [&::-webkit-scrollbar]:hidden"
        data-carousel-viewport
        role="region"
        aria-label="Témoignages de clientes"
        tabindex="0"
      >
        {
          testimonials.map((t) => (
            <figure
              class="flex w-full shrink-0 snap-center flex-col justify-between rounded-2xl bg-(--surface) p-8 soft-glow md:w-[calc((100%-2rem)/2)] md:snap-start lg:w-[calc((100%-4rem)/3)]"
              data-carousel-slide
            >
              <div>
                <div class="mb-4 flex items-center justify-between gap-3">
                  <div
                    class="flex gap-0.5"
                    role="img"
                    aria-label="5 étoiles sur 5"
                  >
                    {Array.from({ length: 5 }).map(() => (
                      <Star
                        class="size-4 fill-[#fbbc04] text-[#fbbc04]"
                        aria-hidden="true"
                      />
                    ))}
                  </div>
                  {t.source === "Avis Google" && (
                    <p class="inline-flex items-center gap-1.5 rounded-full bg-(--surface-container) px-2.5 py-1 text-xs font-semibold tracking-wide text-(--primary)">
                      <svg
                        class="size-3.5 shrink-0"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path
                          fill="#4285F4"
                          d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                        />
                        <path
                          fill="#34A853"
                          d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                        />
                        <path
                          fill="#FBBC05"
                          d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                        />
                        <path
                          fill="#EA4335"
                          d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                        />
                      </svg>
                      Avis Google
                    </p>
                  )}
                </div>
                <blockquote
                  class="text-(--secondary) italic leading-relaxed"
                  style={
                    t.quote.length > 380
                      ? "display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 7;"
                      : undefined
                  }
                >
                  "{t.quote}"
                </blockquote>
                {t.quote.length > 380 && (
                  <button
                    type="button"
                    class="mt-4 font-semibold text-(--primary) underline decoration-(--primary)/30 underline-offset-4 transition hover:decoration-(--primary) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--primary)"
                    data-review-opener
                    data-review-author={t.name}
                    data-review-quote={t.quote}
                    aria-haspopup="dialog"
                  >
                    Lire la suite de l’avis
                  </button>
                )}
              </div>
              {t.name && (
                <figcaption class="mt-6">
                  <p class="font-bold text-(--primary)">{t.name}</p>
                </figcaption>
              )}
            </figure>
          ))
        }
      </div>

      <button
        type="button"
        class="absolute top-1/2 left-0 z-10 flex size-10 -translate-y-1/2 items-center justify-center rounded-full border border-(--outline-variant) bg-(--surface) text-(--primary) shadow-sm transition hover:bg-(--surface-container-high) disabled:pointer-events-none disabled:opacity-30"
        data-carousel-prev
        aria-label="Témoignage précédent"
      >
        <ChevronLeft class="size-5" aria-hidden="true" />
      </button>
      <button
        type="button"
        class="absolute top-1/2 right-0 z-10 flex size-10 -translate-y-1/2 items-center justify-center rounded-full border border-(--outline-variant) bg-(--surface) text-(--primary) shadow-sm transition hover:bg-(--surface-container-high) disabled:pointer-events-none disabled:opacity-30"
        data-carousel-next
        aria-label="Témoignage suivant"
      >
        <ChevronRight class="size-5" aria-hidden="true" />
      </button>
    </div>

    <dialog
      class="m-auto w-[min(42rem,calc(100%-2rem))] max-h-[calc(100dvh-2rem)] rounded-2xl border border-(--outline-variant) bg-(--surface) p-0 text-(--primary) shadow-2xl backdrop:bg-black/45"
      data-review-dialog
      aria-labelledby="review-dialog-title"
    >
      <div class="p-6 sm:p-8">
        <div class="mb-6 flex items-start justify-between gap-4">
          <div>
            <div
              class="mb-3 flex gap-0.5"
              role="img"
              aria-label="5 étoiles sur 5"
            >
              {Array.from({ length: 5 }).map(() => (
                <Star
                  class="size-4 fill-[#fbbc04] text-[#fbbc04]"
                  aria-hidden="true"
                />
              ))}
            </div>
            <h3 id="review-dialog-title" class="text-2xl" data-review-title></h3>
          </div>
          <button
            type="button"
            class="flex size-10 shrink-0 items-center justify-center rounded-full text-(--primary) transition hover:bg-(--surface-container) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--primary)"
            data-review-close
            aria-label="Fermer l’avis"
          >
            <X class="size-5" aria-hidden="true" />
          </button>
        </div>
        <blockquote
          class="text-(--secondary) italic leading-relaxed"
          data-review-content
        ></blockquote>
      </div>
    </dialog>
  </div>
</section>

<script>
  const carousel = document.querySelector("[data-testimonials-carousel]");
  if (!carousel) {
    // noop
  } else {
    const viewport = carousel.querySelector<HTMLElement>(
      "[data-carousel-viewport]",
    );
    const prevBtn = carousel.querySelector<HTMLButtonElement>(
      "[data-carousel-prev]",
    );
    const nextBtn = carousel.querySelector<HTMLButtonElement>(
      "[data-carousel-next]",
    );

    const getSlideStep = () => {
      const slide = viewport?.querySelector<HTMLElement>(
        "[data-carousel-slide]",
      );
      if (!slide || !viewport) return 0;
      const gap =
        Number.parseFloat(
          getComputedStyle(viewport).columnGap ||
            getComputedStyle(viewport).gap,
        ) || 0;
      return slide.offsetWidth + gap;
    };

    const updateButtons = () => {
      if (!viewport || !prevBtn || !nextBtn) return;
      const maxScroll = viewport.scrollWidth - viewport.clientWidth;
      prevBtn.disabled = viewport.scrollLeft <= 1;
      nextBtn.disabled = viewport.scrollLeft >= maxScroll - 1;
      const hideNav = maxScroll <= 1;
      prevBtn.classList.toggle("hidden", hideNav);
      nextBtn.classList.toggle("hidden", hideNav);
    };

    prevBtn?.addEventListener("click", () => {
      viewport?.scrollBy({ left: -getSlideStep(), behavior: "smooth" });
    });

    nextBtn?.addEventListener("click", () => {
      viewport?.scrollBy({ left: getSlideStep(), behavior: "smooth" });
    });

    viewport?.addEventListener("scroll", updateButtons, { passive: true });
    window.addEventListener("resize", updateButtons);
    updateButtons();
  }

  const reviewDialog = document.querySelector<HTMLDialogElement>(
    "[data-review-dialog]",
  );
  const reviewTitle = reviewDialog?.querySelector<HTMLElement>(
    "[data-review-title]",
  );
  const reviewContent = reviewDialog?.querySelector<HTMLElement>(
    "[data-review-content]",
  );
  document.querySelectorAll<HTMLButtonElement>("[data-review-opener]").forEach(
    (opener) => {
      opener.addEventListener("click", () => {
        if (!reviewDialog || !reviewTitle || !reviewContent) return;
        reviewTitle.textContent = opener.dataset.reviewAuthor || "Avis client";
        reviewContent.textContent = `“${opener.dataset.reviewQuote || ""}”`;

        reviewDialog.showModal();
      });
    },
  );

  reviewDialog?.querySelector<HTMLButtonElement>("[data-review-close]")?.addEventListener(
    "click",
    () => reviewDialog.close(),
  );

  reviewDialog?.addEventListener("click", (event) => {
    if (event.target === reviewDialog) reviewDialog.close();
  });
</script>
