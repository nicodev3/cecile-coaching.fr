---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import coachImage from '../../assets/cecile-coach-apa.webp';
import heroImage from '../../assets/coach-apa-hero.png';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Header from '../../components/Header.astro';
import QuizCtaLink from '../../components/QuizCtaLink.astro';
import Testimonials from '../../components/Testimonials.astro';
import TunnelCtaLink from '../../components/TunnelCtaLink.astro';
import WhatsAppCtaLink from '../../components/WhatsAppCtaLink.astro';
import { offerCtaEvent } from '../../config/analyticsEvents';

const title = 'Coach APA en ligne : séances visio | RE-FLOW';
const description =
	'Coach APA en ligne avec Cécile Cichosz : séances en visio, partout en France, pour reprise du mouvement avec une maladie ou une fatigue chronique.';

const faqs = [
	{
		q: 'Combien de temps faut-il prévoir pour RE-FLOW ?',
		a: 'Le programme dure 4 mois, soit 16 semaines. Il propose 3 séances vidéo d’environ 30 minutes par semaine, à ajuster selon ton énergie, ainsi qu’un point individuel en visio chaque semaine et une séance collective tous les 15 jours. Ce rythme est un repère à discuter avec Cécile, pas une obligation de réaliser toutes les séances.',
	},
	{
		q: 'Quel matériel faut-il pour suivre le programme ?',
		a: 'Pour les rendez-vous en visio et les vidéos, prévois une connexion Internet et un téléphone, une tablette ou un ordinateur. L’espace disponible chez toi et le matériel nécessaire aux exercices sont à préciser avec Cécile lors du premier échange, avant de t’équiper.',
	},
	{
		q: 'Quel est le tarif et peut-on payer en plusieurs fois ?',
		a: 'Le tarif est communiqué sur demande, avec les modalités de l’accompagnement. Un paiement en 2 ou 3 fois est possible. Cécile t’explique ces conditions lors de votre échange, avant toute inscription.',
	},
	{
		q: 'Et si je suis trop fatiguée ou si je manque une séance ?',
		a: 'Le rythme des vidéos est ajustable selon ton énergie et les séances collectives sont accessibles en replay. Préviens Cécile pour discuter des ajustements et des modalités si tu ne peux pas assister à un rendez-vous individuel. L’objectif n’est pas de rattraper toutes les séances à tout prix.',
	},
	{
		q: 'Qu’est-ce qu’un coach APA ?',
		a: "Dans l’usage courant, on parle parfois de coach APA pour désigner un accompagnement du mouvement adapté à la santé. En France, les enseignant·es en APA ont une formation universitaire STAPS APA-S. RE-FLOW est proposé par Cécile Cichosz, coach sportive diplômée d’État BPJEPS Activités de la forme et certifiée APA, avec un cadre progressif et adapté, non médical.",
	},
	{
		q: 'L’Activité Physique Adaptée est-elle possible en ligne ?',
		a: "Oui. L’APA en ligne se pratique en visio, avec des séances pensées pour ton espace, ton matériel et ton niveau du jour. Ce format évite les déplacements — souvent coûteux en énergie — et permet un accompagnement régulier partout en France, à condition que le cadre reste progressif et sécurisant.",
	},
	{
		q: 'Quelle est la différence entre un coach APA et un coach sportif ?',
		a: "Un coach sportif classique accompagne souvent la performance ou la remise en forme de personnes globalement en bonne santé. Un accompagnement inspiré de l’APA part de la santé : maladie chronique, fatigue, douleurs chroniques, traitements, appréhension du mouvement. Le contenu des séances est construit autour de ces réalités, pas autour d’un programme standard.",
	},
	{
		q: 'Peut-on faire de l’APA avec une fatigue chronique ?',
		a: "Oui, à condition de doser très progressivement : séances courtes, versions allégées pour les jours difficiles, attention portée à la récupération et au malaise post-effort. En cas de syndrome de fatigue chronique (SFC/EM) ou de pathologie instable, l’avis du médecin reste le point de départ.",
	},
	{
		q: 'L’accompagnement remplace-t-il un suivi médical ?',
		a: "Non, jamais. Le coaching sportif adapté ne remplace ni un avis médical, ni un traitement, ni un suivi de santé. Il vient en complément, pour t’aider à reprendre une activité physique compatible avec ta situation. En cas de symptôme nouveau ou de doute, le médecin reste la référence.",
	},
	{
		q: 'Comment commencer si je suis très fatiguée ?',
		a: "On commence par un échange pour comprendre ta situation, puis par des séances très courtes — parfois quelques minutes — adaptées à ton énergie réelle. Il n’y a pas de niveau minimum requis : le point de départ, c’est ce que ton corps peut faire aujourd’hui, pas ce qu’il « devrait » pouvoir faire.",
	},
];

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const siteUrl = Astro.site?.toString() ?? `${Astro.url.origin}/`;
const siteUrlNormalized = siteUrl.endsWith('/') ? siteUrl.slice(0, -1) : siteUrl;

const serviceStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	'@id': `${pageUrl}#service`,
	name: 'Coaching sportif adapté en ligne',
	serviceType: 'Coaching sportif adapté en ligne',
	description,
	url: pageUrl,
	provider: { '@id': `${siteUrlNormalized}/#coaching-service` },
	areaServed: { '@type': 'Country', name: 'France' },
	audience: {
		'@type': 'Audience',
		audienceType:
			'Femmes vivant avec une maladie chronique, une fatigue chronique ou des douleurs chroniques',
	},
};

const faqStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: {
			'@type': 'Answer',
			text: f.a,
		},
	})),
};
---

<BaseLayout
	title={title}
	description={description}
	structuredData={[serviceStructuredData, faqStructuredData]}
>
	<Fragment slot="header">
		<Header />
	</Fragment>

	<article class="border-b border-black/5 bg-white/35">
		<div class="mx-auto max-w-3xl px-4 pb-12 sm:px-6 sm:pt-0 sm:pb-12 lg:px-8">
			<section class="relative left-1/2 min-h-[32rem] w-screen -translate-x-1/2 overflow-hidden sm:min-h-[30rem]" aria-labelledby="coach-apa-hero-title">
				<Image
					src={heroImage}
					alt="Une femme pratique un étirement doux à domicile dans un espace lumineux"
					class="absolute inset-0 size-full object-cover object-top"
					loading="eager"
					fetchpriority="high"
				/>
				<div class="absolute inset-0 bg-linear-to-r from-white via-white/85 to-white/10" aria-hidden="true"></div>
				<div class="relative mx-auto flex min-h-[32rem] max-w-3xl flex-col px-4 pt-4 sm:min-h-[30rem] sm:px-6 sm:pt-6 lg:px-8">
					<Breadcrumbs
						items={[
							{ name: 'Accueil', href: '/' },
							{ name: 'Coaching sportif adapté', href: '/coach-apa-en-ligne/' },
						]}
					/>
					<div class="flex flex-1 items-center pb-8 sm:pb-12">
						<div class="max-w-xl">
							<p class="text-sm font-semibold tracking-widest text-(--primary-container) uppercase">Accompagnement en ligne</p>
							<h1 id="coach-apa-hero-title" class="mt-3 text-3xl leading-tight font-semibold text-(--on-surface) sm:text-4xl">
								Coach APA en ligne&nbsp;: séances en visio pour maladie chronique
							</h1>
							<p class="mt-5 max-w-2xl text-base leading-relaxed text-(--secondary)">
								Des séances en visio avec Cécile Cichosz, coach sportive diplômée d’État et certifiée APA. Un accompagnement doux et progressif, depuis chez toi, pour les femmes vivant avec une maladie chronique, une fatigue ou des douleurs.
							</p>
							<div class="mt-6 flex flex-col items-start gap-3 sm:flex-row sm:flex-wrap sm:items-center">
								<a
									href="/contact/"
									data-umami-event={offerCtaEvent('coach-apa-en-ligne-hero')}
									class="inline-flex items-center justify-center rounded-full bg-(--primary) px-7 py-3 text-base font-medium text-(--on-primary) transition hover:bg-(--primary-container) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--primary)"
								>
									Demander un échange avec Cécile
								</a>
								<QuizCtaLink
									campaign="coach-apa-en-ligne"
									class="inline-flex items-center justify-center rounded-full border-2 border-(--primary) bg-(--surface-container-lowest) px-7 py-3 text-base font-medium text-(--primary) transition hover:bg-(--surface-container) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--primary)"
								>
									Faire l’auto-évaluation
								</QuizCtaLink>
							</div>
							<p class="mt-3 text-sm leading-relaxed text-(--secondary)">
								Le bouton ouvre le formulaire de contact. Cécile te répond sous 24 à 48 h ouvrées pour organiser un échange gratuit, sans engagement.
							</p>
						</div>
					</div>
				</div>
			</section>

			<section class="mt-12 rounded-3xl bg-(--sage)/25 p-6 sm:p-8" aria-labelledby="reflow-programme-title">
				<p class="text-sm font-semibold tracking-widest text-(--primary) uppercase">Le programme RE-FLOW</p>
				<h2 id="reflow-programme-title" class="mt-3 text-2xl font-semibold text-(--on-surface) sm:text-3xl">4 mois pour construire ton rythme, avec Cécile</h2>
				<p class="mt-4 leading-relaxed text-slate-700">Des vidéos à suivre chez toi, des rendez-vous en direct et un suivi personnalisé. Tu sais quoi pratiquer et tu peux échanger avec Cécile pour adapter le programme à ton quotidien.</p>
				<dl class="mt-6 grid gap-4 sm:grid-cols-2">
					<div class="rounded-2xl bg-white/80 p-5">
						<dt class="text-lg font-semibold text-(--primary)">48 séances vidéo guidées</dt>
						<dd class="mt-2 text-slate-700">3 séances proposées par semaine pendant 16 semaines, à suivre en autonomie. Environ 30 minutes par séance, avec un rythme et des durées ajustables selon ton énergie.</dd>
					</div>
					<div class="rounded-2xl bg-white/80 p-5">
						<dt class="text-lg font-semibold text-(--primary)">Un point individuel chaque semaine</dt>
						<dd class="mt-2 text-slate-700">Un rendez-vous en visioconférence avec Cécile pour faire le point sur tes ressentis, poser tes questions et ajuster ton programme.</dd>
					</div>
					<div class="rounded-2xl bg-white/80 p-5">
						<dt class="text-lg font-semibold text-(--primary)">Une séance collective tous les 15 jours</dt>
						<dd class="mt-2 text-slate-700">Un rendez-vous sur Zoom, accessible en direct ou en replay, pour pratiquer depuis chez toi.</dd>
					</div>
					<div class="rounded-2xl bg-white/80 p-5">
						<dt class="text-lg font-semibold text-(--primary)">Un suivi entre les rendez-vous</dt>
						<dd class="mt-2 text-slate-700">Un accompagnement WhatsApp, des conseils personnalisés et des supports pour te repérer. Un bilan forme au début et à la fin du programme.</dd>
					</div>
				</dl>
				<p class="mt-5 text-sm leading-relaxed text-slate-700">Les 3 séances hebdomadaires sont un repère, pas un quota à atteindre. Les adaptations se discutent avec Cécile, en tenant compte de tes limites et des consignes de ton équipe soignante.</p>
			</section>

			<div class="pillar-article mx-auto mt-14 max-w-[68ch] text-base leading-relaxed text-slate-800">
				<div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_18rem]">
					<div>
						<h2>Pour qui est cet accompagnement ?</h2>
						<p>
							Cet accompagnement s’adresse aux femmes pour qui le sport classique est devenu trop intense, trop
							rigide ou trop culpabilisant : <strong>maladie chronique</strong>, fatigue persistante,&nbsp;<strong>douleurs chroniques</strong>, traitements en cours, longue période d’inactivité ou perte de
							confiance dans le corps.
						</p>
						<ul>
							<li>Tu vis avec une maladie chronique et ton énergie varie d’un jour à l’autre</li>
							<li>Tu veux reprendre une activité physique sans aggraver ta fatigue ni tes douleurs</li>
							<li>Tu as déjà essayé des programmes sportifs classiques et tu as abandonné — pas par manque de volonté</li>
							<li>Tu cherches un cadre doux, sans performance, sans comparaison et sans injonctions</li>
							<li>Tu préfères un accompagnement en ligne, depuis chez toi, sans déplacement</li>
						</ul>
					</div>
					<div class="mx-auto w-full max-w-sm overflow-hidden rounded-2xl bg-(--surface-container) lg:max-w-none">
						<Image
							src={coachImage}
							alt="Cécile, coach sportive certifiée APA, assise sur un tapis de mouvement"
							class="aspect-[4/3] size-full object-cover object-top"
							width={1200}
							height={1600}
						/>
					</div>
				</div>

				<h2>Coach APA, BPJEPS, Activité Physique Adaptée : comment s’y retrouver ?</h2>
				<p>
					Le terme <strong>coach APA</strong> est souvent utilisé en ligne pour chercher un accompagnement
					du mouvement adapté à la santé. En France, les <strong>enseignant·es en APA</strong> sont titulaires
					d’une formation universitaire STAPS mention APA-S. Chez RE-FLOW, l’accompagnement est proposé par <strong>Cécile Cichosz, coach sportive diplômée d’État BPJEPS Activités de la forme et certifiée APA</strong>, dans un cadre
					de coaching sportif adapté, progressif et non médical.
				</p>
				<p>
					Pour comprendre l’approche APA en détail, consulte le <a href="/blog/coach-apa/">guide complet sur le coach APA</a>,
					le guide <a href="/activites-physiques-adaptees/">Activité Physique Adaptée : définition et bienfaits</a>, ainsi que <a href="/a-propos/">le parcours de Cécile Cichosz</a>.
				</p>

				<section aria-labelledby="reflow-etapes-title">
					<h2 id="reflow-etapes-title">Comment se déroule RE-FLOW&nbsp;?</h2>
					<ol class="space-y-5">
						<li class="rounded-2xl border border-(--primary)/15 bg-white/70 p-5">
							<h3 class="!mt-0">1. Faire connaissance et vérifier si le programme convient</h3>
							<p class="!mb-0">Tu envoies un message via le formulaire de contact. Lors de votre échange, Cécile prend le temps de comprendre tes besoins, tes contraintes, ton énergie et tes objectifs. Vous précisez le cadre de l’accompagnement, les conditions et le tarif avant de décider de commencer.</p>
						</li>
						<li class="rounded-2xl border border-(--primary)/15 bg-white/70 p-5">
							<h3 class="!mt-0">2. Définir ton point de départ</h3>
							<p class="!mb-0">Un bilan forme personnalisé aide à choisir les adaptations et à organiser ta pratique chez toi. L’espace disponible, le matériel et les durées des séances sont discutés avec Cécile.</p>
						</li>
						<li class="rounded-2xl border border-(--primary)/15 bg-white/70 p-5">
							<h3 class="!mt-0">3. Pratiquer et ajuster au fil des semaines</h3>
							<p class="!mb-0">Tu suis les vidéos en autonomie, tu retrouves le groupe en direct ou en replay et tu fais le point avec Cécile chaque semaine. Les rendez-vous individuels servent à adapter le programme à ce que tu ressens réellement.</p>
						</li>
					</ol>
				</section>

				<h2>Quel type de mouvement est proposé&nbsp;?</h2>
				<p>RE-FLOW associe <strong>Pilates, yoga, renforcement musculaire et relaxation</strong>. Les vidéos guident la pratique à domicile et les échanges avec Cécile permettent de discuter des adaptations. Pour découvrir des mouvements et leurs variantes, consulte les <a href="/blog/activite-physique-adaptee-exercices/">exemples d’exercices d’Activité Physique Adaptée</a>.</p>

				<section class="mt-10 rounded-2xl bg-(--sage)/20 p-6" aria-labelledby="reflow-pratique-title">
					<h2 id="reflow-pratique-title" class="!mt-0">Tarif et informations pratiques</h2>
					<ul>
						<li><strong>Durée&nbsp;:</strong> 4 mois, soit 16 semaines d’accompagnement.</li>
						<li><strong>À prévoir&nbsp;:</strong> une connexion Internet et un téléphone, une tablette ou un ordinateur pour les vidéos et les rendez-vous en visio. Le matériel des exercices est précisé avec Cécile avant de t’équiper.</li>
						<li><strong>Disponibilités&nbsp;:</strong> des temps de pratique en autonomie et un point individuel hebdomadaire. Les séances collectives peuvent être suivies en replay.</li>
						<li><strong>Tarif sur demande&nbsp;:</strong> Cécile te communique le prix et les modalités avant toute inscription. Le paiement en 2 ou 3 fois est possible.</li>
					</ul>
					<a href="/contact/" data-umami-event={offerCtaEvent('coach-apa-en-ligne-programme')} class="inline-flex items-center justify-center rounded-full bg-(--primary) px-6 py-3 font-semibold !text-white !no-underline transition hover:bg-(--plum-ink) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--primary)">Demander le tarif et un échange</a>
					<p class="!mt-4 !mb-0 text-sm">Le formulaire te permet de présenter ta situation et de poser tes questions. Réponse sous 24 à 48 h ouvrées, sans engagement.</p>
				</section>

				<h2>Dans quelles situations ce coaching adapté en ligne peut-il aider ?</h2>
				<p>
					Un <strong>coaching sportif adapté en ligne</strong> peut aider dans de nombreuses situations où le
					corps demande un cadre particulier, toujours en complément du suivi médical et avec l’accord du
					médecin quand la situation le demande :
				</p>
				<ul>
					<li><strong>Fatigue chronique</strong> : doser le mouvement sans déclencher de malaise post-effort — voir le guide <a href="/fatigue-chronique-mouvement/">fatigue chronique et mouvement</a></li>
					<li><strong>Douleurs chroniques</strong> : bouger sans aggraver, avec des alternatives pour chaque exercice</li>
					<li><strong>Fibromyalgie</strong> : un rythme très progressif qui respecte les fluctuations de douleur et de sommeil</li>
					<li><strong>Endométriose</strong> : adapter l’intensité aux cycles, aux douleurs et à la fatigue</li>
					<li><strong>Cancer et suites de traitement</strong> : entretenir le mouvement pendant ou après les traitements, en lien avec l’équipe soignante</li>
					<li><strong>Burn-out</strong> : retrouver un contact corporel doux, sans performance ni pression</li>
					<li><strong>Reprise après un arrêt long</strong> : limiter le déconditionnement et reconstruire pas à pas</li>
					<li><strong>Maladie chronique</strong> au sens large (auto-immune, cardiovasculaire stabilisée, métabolique…) — voir le guide <a href="/mouvement-maladie-chronique/">mouvement et maladie chronique</a></li>
				</ul>

				<h2>Coach APA, coach sportif ou kiné : quelle différence ?</h2>
				<p>
					Le <strong>kinésithérapeute</strong> est un professionnel de santé : soins, rééducation, douleur
					aiguë, souvent sur prescription. Le <strong>coach sportif</strong> accompagne la performance et la
					remise en forme de personnes globalement aptes. Un accompagnement de type APA ou sport-santé
					s’intéresse à la reprise ou au maintien d’un <strong>mouvement adapté</strong> au quotidien,
					quand la santé est fragile ou variable — sans poser de diagnostic ni remplacer les soins.
				</p>
				<p>
					Pour t’orienter selon ta situation, lis l’article&nbsp;<a href="/blog/kine-coach-sportif-coach-apa/">kiné, coach sportif ou coach APA : qui consulter ?</a>.
				</p>

				<h2>Ce que cet accompagnement peut t’aider à faire</h2>
				<p>
					L’Activité Physique Adaptée ne promet pas de guérison et ne constitue pas un traitement médical.
					Elle peut en revanche, selon ta situation, t’aider à :
				</p>
				<ul>
					<li>Reprendre une activité physique sans te mettre en échec</li>
					<li>Entretenir ta force musculaire et ta mobilité, sans chercher la performance</li>
					<li>Rendre certains gestes du quotidien moins coûteux en énergie</li>
					<li>Réduire la peur de bouger après une période difficile</li>
					<li>Apprendre à doser l’effort selon les signaux de ton corps</li>
					<li>Retrouver une relation plus apaisée et plus confiante avec ton corps</li>
				</ul>
				<p>
					Ces bénéfices dépendent de ta situation et ne sont jamais garantis. L’accompagnement ne remplace
					pas un avis médical ni un suivi de santé : en cas de douleur nouvelle, de symptôme inhabituel ou de
					maladie instable, le médecin reste la première personne à consulter.
				</p>

				<h2>La méthode RE-FLOW</h2>
				<p>L’accompagnement repose sur cinq repères simples :</p>
				<ul>
					<li><strong>Douceur</strong> : aucun exercice ne doit te brutaliser ni te mettre en échec</li>
					<li><strong>Progressivité</strong> : des étapes courtes, répétables et réalistes, jamais de paliers forcés</li>
					<li><strong>Écoute corporelle</strong> : apprendre à distinguer effort utile, fatigue excessive et signal d’alerte</li>
					<li><strong>Sécurité</strong> : ne pas forcer quand le corps envoie un signal clair, et respecter les avis médicaux</li>
					<li><strong>Autonomie</strong> : devenir capable d’adapter toi-même ton mouvement selon l’énergie du jour</li>
				</ul>
			</div>

			<section class="mt-14 border-t border-black/10 pt-12" aria-labelledby="coach-apa-faq-title">
				<h2 id="coach-apa-faq-title" class="text-2xl font-semibold text-(--on-surface)">Questions fréquentes</h2>
				<div class="mt-6 space-y-3">
					{
						faqs.map((f) => (
							<details class="group rounded-2xl bg-white/70 px-5 py-4 ring-1 ring-black/5">
								<summary class="cursor-pointer list-none text-base font-semibold text-(--on-surface) outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--plum)">
									<span class="flex items-center justify-between gap-3">
										<span>{f.q}</span>
										<span
											class="grid size-8 shrink-0 place-items-center rounded-xl bg-(--sage)/70 text-lg leading-none ring-1 ring-black/5"
											aria-hidden="true"
										>
											<span class="transition group-open:rotate-45">+</span>
										</span>
									</span>
								</summary>
								<p class="mt-3 text-base leading-relaxed text-slate-700">{f.a}</p>
							</details>
						))
					}
				</div>
			</section>

			<div
				class="mt-12 rounded-3xl bg-(--plum) px-6 py-10 text-center text-white shadow-sm shadow-black/15 sm:px-10"
			>
				<h2 class="text-xl font-semibold sm:text-2xl">Envie d’en parler, sans engagement ?</h2>
				<p class="mt-3 text-base text-white/90">
					Chaque situation est différente. Écris-moi pour voir ensemble, simplement et sans pression, si cet
					accompagnement sportif adapté en ligne peut te correspondre.
				</p>
				<div class="mt-6 flex flex-col items-center justify-center gap-4 sm:flex-row sm:flex-wrap">
					<a
						href="/contact/"
						data-umami-event={offerCtaEvent('coach-apa-en-ligne-final')}
