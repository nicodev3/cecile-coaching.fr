---
import { Image } from 'astro:assets';
import coachPortrait from '../../../assets/cecile-coach-sportive.webp';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReflowAssessment from '../../../components/ReflowAssessment.astro';
import { TOTAL_QUESTIONS } from '../../../data/reflow';

const title = 'Découvre ton profil Re-flow | RE-FLOW';
const description =
	'12 questions pour découvrir ton profil Re-flow : Reconnexion, Énergie, Force ou Équilibre, et identifier ton besoin pour reprendre une activité physique.';

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

const appStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	'@id': `${pageUrl}#app`,
	name: 'Auto-évaluation Re-flow',
	description,
	url: pageUrl,
	applicationCategory: 'LifestyleApplication',
	operatingSystem: 'Web',
	browserRequirements: 'Nécessite JavaScript pour le calcul automatique du résultat.',
	inLanguage: 'fr-FR',
	isAccessibleForFree: true,
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
};

---

<BaseLayout
	title={title}
	description={description}
	structuredData={appStructuredData}
	showFooterNavigation={false}
	showFooterBrand={false}
	showWhatsAppFloating={false}
>
	<article class="border-b border-black/5 bg-white/35">
		<div class="mx-auto max-w-3xl px-4 pt-2 pb-12 sm:px-6 sm:py-12 lg:px-8">
			<section data-rg-intro>
				<div class="rounded-2xl bg-(--surface-container-lowest) px-4 py-8 text-center ring-1 ring-(--outline-variant) sm:px-8 sm:py-10">
					<span class="mx-auto block size-28 overflow-hidden rounded-full ring-1 ring-(--outline-variant) sm:size-32">
						<Image
							src={coachPortrait}
							alt="Cécile, coach sportive"
							class="size-full object-cover object-[50%_0%]"
							width={360}
							height={540}
							loading="eager"
						/>
					</span>
					<p class="mt-4 text-base font-semibold text-(--on-surface)">
						Je suis Cécile, coach sportive.
					</p>
					<p class="mx-auto mt-2 max-w-xl text-sm leading-relaxed text-(--secondary) sm:text-base">
						J'aide les femmes épuisées physiquement et moralement, à reprendre confiance dans leur corps à l'aide d'une méthode adaptée, accessible et progressive.
					</p>
					<h1 class="mt-8 text-xl leading-tight font-semibold text-(--primary) sm:text-4xl">
						Quizz : Fais le point sur tes capacités physiques en {TOTAL_QUESTIONS} questions
					</h1>
					<p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-(--secondary)">
						À l’issue du quizz, découvre ton profil et les actions à mener pour avancer. Tu pourras aussi réserver un rendez-vous téléphonique avec Cécile pour faire le point ensemble.
					</p>
				</div>
			</section>

			<div class="mt-4 sm:mt-10">
				<ReflowAssessment />
			</div>
		</div>
	</article>
</BaseLayout>
