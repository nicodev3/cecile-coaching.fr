---
import { Image } from 'astro:assets';
import coachPortrait from '../../../assets/cecile-coach-sportive.webp';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReflowAssessment from '../../../components/ReflowAssessment.astro';
import { TOTAL_QUESTIONS } from '../../../data/reflow';

const title = 'Découvre ton profil Re-flow | RE-FLOW';
const description =
	'12 questions pour découvrir ton profil Re-flow : Reconnexion, Énergie, Force ou Équilibre, et identifier ton besoin pour reprendre une activité physique.';

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

const appStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	'@id': `${pageUrl}#app`,
	name: 'Auto-évaluation Re-flow',
	description,
	url: pageUrl,
	applicationCategory: 'LifestyleApplication',
	operatingSystem: 'Web',
	browserRequirements: 'Nécessite JavaScript pour le calcul automatique du résultat.',
	inLanguage: 'fr-FR',
	isAccessibleForFree: true,
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
};

---

<BaseLayout
	title={title}
	description={description}
	structuredData={appStructuredData}
	showFooterNavigation={false}
	showFooterBrand={false}
	footerCompact
	showWhatsAppFloating={false}
>
	<article class="border-b border-black/5 bg-(--sage)/40">
		<div class="mx-auto max-w-3xl px-4 pt-2 pb-12 sm:px-6 sm:py-12 lg:px-8">
			<section data-rg-intro>
				<div class="rounded-2xl bg-(--surface-container-lowest) px-4 py-8 text-center ring-1 ring-(--outline-variant) sm:px-8 sm:py-10">
					<span class="mx-auto block size-28 overflow-hidden rounded-full ring-1 ring-(--outline-variant) sm:size-32">
						<Image
							src={coachPortrait}
							alt="Portrait de Cécile Cichosz"
							class="size-full object-cover object-[50%_0%]"
							width={360}
							height={540}
							loading="eager"
						/>
					</span>
					<p class="mt-4 text-base text-(--on-surface)">
						Cécile Cichosz, coach en Activité Physique Adaptée.
					</p>
					<h1 class="mt-8 text-xl leading-tight font-medium text-balance text-(--primary) sm:text-4xl">
						Découvre ce dont tu as (vraiment) besoin pour retrouver de l’énergie.
					</h1>
					<p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-(--secondary)">
						Réponds à ces {TOTAL_QUESTIONS} questions pour faire le point sur tes capacités physiques.
					</p>
					<p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-(--secondary)">
						À l’issue du quiz, découvre ton profil et les actions à mener pour avancer.
					</p>
					<button
						type="button"
						class="mx-auto mt-8 flex w-full max-w-xl items-center justify-center rounded-full bg-(--primary) px-8 py-3.5 text-lg font-medium text-(--on-primary) transition hover:bg-(--primary-container) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--primary) cursor-pointer"
						data-rg-start
					>
						Commencer le quiz
					</button>
					<p class="mt-3 text-sm text-(--secondary)">2 minutes pas plus — 100&nbsp;% gratuit</p>
					<p class="mt-6">
						<a
							href="/"
							class="text-sm font-medium text-(--secondary) underline decoration-(--outline-variant) underline-offset-4 transition hover:text-(--primary) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--primary)"
						>
							Revenir à l’accueil
						</a>
					</p>
				</div>
			</section>

			<div class="mt-4 sm:mt-10" data-rg-quiz-panel hidden>
				<ReflowAssessment />
			</div>
		</div>
	</article>
</BaseLayout>
